<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WorkflowSdkPanelBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="{Binding Title}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource WorkflowSdkTextBrush}"
                       FontWeight="SemiBold" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource WorkflowSdkSurfaceBrush}"
                BorderBrush="{DynamicResource WorkflowSdkBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                <TextBlock Text="No processed feature image for this Action yet"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WorkflowSdkMutedTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border VerticalAlignment="Bottom"
                        Background="{DynamicResource WorkflowSdkPanelBrush}"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="{Binding OutputSummary}"
                                   Foreground="{DynamicResource WorkflowSdkTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PreviewInfo}"
                                   Foreground="{DynamicResource WorkflowSdkMutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="4,7,4,0"
                   Text="Double-click this Action to edit feature-extraction parameters."
                   Foreground="{DynamicResource WorkflowSdkSuccessBrush}"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
