<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FF111315">
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="12" />
        <TextBlock Text="No preview yet"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#FF858A8E">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPreview}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Border VerticalAlignment="Bottom" Background="#C0000000" Padding="8">
            <TextBlock Text="{Binding PreviewInfo}" Foreground="White" />
        </Border>
    </Grid>
</UserControl>
