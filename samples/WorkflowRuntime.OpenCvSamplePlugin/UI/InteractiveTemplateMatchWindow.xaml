<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorkflowRuntime.OpenCvSamplePlugin.UI"
        Title="模板匹配 - OpenCV SDK" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#FF202020" Foreground="#FFF2F2F2">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#FF292929"/><SolidColorBrush x:Key="Line" Color="#FF505050"/>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#FFF2F2F2"/><Setter Property="Background" Value="#FF3B3B3B"/><Setter Property="BorderBrush" Value="#FF626262"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#FFB9E986"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="7"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#FFE8E8E8"/><Setter Property="Background" Value="#FF303030"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinWidth" Value="88"/></Style>
        <DataTemplate x:Key="PropertyRowTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" Foreground="#FFD7D7D7" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Description}"/>
                <local:DesignerPropertyEditorHost Grid.Column="1" Property="{Binding}" ActionContext="{Binding DataContext.Context, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
        <Border Background="#FF242424" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid><StackPanel><TextBlock Text="模板匹配" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="选择区域 → 学习模型 → 编辑掩膜/去噪 → 保存模型 → 搜索匹配" Foreground="#FF9FA7AD" Margin="0,3,0,0"/></StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFB9E986" Text="OpenCV SDK · 单一 Action 插件"/></Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="365"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TabControl TabStripPlacement="Left" Margin="7">
                <TabItem Header="基本参数">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <GroupBox Header="图像链接"><StackPanel>
                            <ContentControl Content="{Binding LearningImageProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding SearchImageProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="搜索区域（宽或高为 0 时使用全图）"><StackPanel>
                            <ContentControl Content="{Binding SearchRoiXProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding SearchRoiYProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding SearchRoiWidthProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding SearchRoiHeightProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding ShowSearchRegionProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="模板设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <GroupBox Header="学习流程"><StackPanel>
                            <UniformGrid Columns="2"><Button Content="1  开始学习" Command="{Binding StartLearningCommand}"/><Button Content="2  完成学习" Command="{Binding LearnModelCommand}"/></UniformGrid>
                            <Button Content="编辑模板掩膜 / 橡皮擦去噪" Command="{Binding EditMaskCommand}" Margin="3,5"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="学习区域"><StackPanel>
                            <ContentControl Content="{Binding RoiXProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding RoiYProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding RoiWidthProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding RoiHeightProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="模型文件"><StackPanel>
                            <ContentControl Content="{Binding ModelFileProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding ModelTypeProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="特征提取"><StackPanel>
                            <ContentControl Content="{Binding EdgeLowProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding EdgeHighProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding BlurSizeProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="查找参数">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <GroupBox Header="角度范围"><StackPanel>
                            <ContentControl Content="{Binding MinAngleProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding MaxAngleProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding AngleStepProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="缩放范围"><StackPanel>
                            <ContentControl Content="{Binding MinScaleProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding MaxScaleProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding ScaleStepProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="匹配控制"><StackPanel>
                            <ContentControl Content="{Binding MinimumScoreProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding MaximumMatchesProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding MaximumOverlapProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding ShowResultContourProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                            <ContentControl Content="{Binding PublishPreviewProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        </StackPanel></GroupBox>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="数据结果">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="运行结果绑定" FontWeight="SemiBold" Foreground="#FFB9E986" Margin="8"/>
                        <ContentControl Content="{Binding OutputImageProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding TemplateImageProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding SavedPathProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding MatchedProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding MatchCountProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding ScoreProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding MatchXProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding MatchYProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding MatchAngleProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                        <ContentControl Content="{Binding MatchScaleProperty}" ContentTemplate="{StaticResource PropertyRowTemplate}"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FF505050"/>

            <Grid Grid.Column="2" Margin="5,7,8,7">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                <Border Background="#FF292929" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="指针" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:TemplateEditorTool.Pointer}"/><Button Content="学习框" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:TemplateEditorTool.LearnRoi}"/>
                        <Separator Margin="6,2"/>
                        <Button Content="添加区域" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:TemplateEditorTool.AddMask}"/><Button Content="橡皮擦" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:TemplateEditorTool.EraseMask}"/>
                        <TextBlock Text="画刷" Margin="12,0,4,0" VerticalAlignment="Center"/>
                        <ComboBox Width="76" SelectedValuePath="Tag" SelectedValue="{Binding BrushShape, Mode=TwoWay}"><ComboBoxItem Content="圆形" Tag="{x:Static local:TemplateBrushShape.Circle}"/><ComboBoxItem Content="矩形" Tag="{x:Static local:TemplateBrushShape.Rectangle}"/></ComboBox>
                        <Slider Width="90" Minimum="2" Maximum="100" Value="{Binding BrushSize, Mode=TwoWay}" Margin="8,0"/>
                        <TextBlock Text="{Binding BrushSize}" Width="28" VerticalAlignment="Center"/>
                        <Button Content="全选" Command="{Binding ResetMaskAllCommand}"/><Button Content="清空" Command="{Binding ResetMaskEmptyCommand}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#FF090909" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0">
                    <Grid x:Name="PreviewSurface" ClipToBounds="True" Cursor="Cross"
                          local:TemplateMatchCanvasBehavior.IsEnabled="True">
                        <Image x:Name="PreviewImageControl" Source="{Binding DisplayImage}" Stretch="Uniform"/>
                        <Image x:Name="MaskOverlayControl" Source="{Binding MaskOverlay}" Stretch="Uniform" IsHitTestVisible="False"/>
                        <Canvas IsHitTestVisible="False"><Rectangle x:Name="SearchRectangle" Visibility="Collapsed" Stroke="#FF00B7FF" StrokeThickness="2" StrokeDashArray="5,3"/>
                            <Rectangle x:Name="LearningRectangle" Visibility="Collapsed" Stroke="#FFFFFF00" StrokeThickness="2" Fill="#12FFFF00"/>
                            <Ellipse x:Name="BrushCursor" Visibility="Collapsed" Stroke="#FFFF5050" StrokeThickness="2"/></Canvas>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,4" Background="#C0000000"><TextBlock Text="黄色：学习区域   蓝色：搜索区域   红色遮罩：已排除区域" Foreground="#FFFFE77A"/></Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="#FF292929" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding PreviewInfo}" Foreground="#FFAAB1B6" Margin="12,0,0,0"/><TextBlock Text="{Binding Status}" Foreground="#FFF0F0F0" TextWrapping="Wrap"/></DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FF242424">
            <DockPanel Margin="8"><TextBlock VerticalAlignment="Center" Foreground="#FF9FA7AD" Text="生产运行使用已保存模型（MatchOnly），不会重复学习。"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="执行匹配" Width="105" Command="{Binding ExecuteMatchCommand}"/><Button Content="取消" Width="88" Command="{x:Static local:DesignerCommands.CloseWindow}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/><Button Content="确认" Width="88" Background="#FF6D9F36" BorderBrush="#FF87C548" Command="{x:Static local:DesignerCommands.CloseWindow}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
