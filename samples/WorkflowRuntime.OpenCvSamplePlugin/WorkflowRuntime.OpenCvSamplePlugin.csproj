<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DeployToWorkflowRuntimeOnBuild Condition="'$(DeployToWorkflowRuntimeOnBuild)' == '' and '$(Configuration)' == 'Debug'">true</DeployToWorkflowRuntimeOnBuild>
    <DeployToWorkflowRuntimeOnBuild Condition="'$(DeployToWorkflowRuntimeOnBuild)' == ''">false</DeployToWorkflowRuntimeOnBuild>
    <DeployToWorkflowDesignerOnBuild Condition="'$(DeployToWorkflowDesignerOnBuild)' == '' and '$(Configuration)' == 'Debug'">true</DeployToWorkflowDesignerOnBuild>
    <DeployToWorkflowDesignerOnBuild Condition="'$(DeployToWorkflowDesignerOnBuild)' == ''">false</DeployToWorkflowDesignerOnBuild>
    <WorkflowRuntimePluginDirectory Condition="'$(WorkflowRuntimePluginDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\src\WorkflowRuntime.WindowsService\bin\$(Configuration)\net8.0\plugins\WorkflowRuntime.OpenCvSamplePlugin</WorkflowRuntimePluginDirectory>
    <WorkflowDesignerPluginDirectory Condition="'$(WorkflowDesignerPluginDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\src\WorkflowDesigner\bin\$(Configuration)\net8.0-windows\designer-plugins\OpenCvSample</WorkflowDesignerPluginDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WorkflowRuntime.ActionSdk" Version="$(WorkflowVersion)" />
    <PackageReference Include="WorkflowRuntime.ResourceSdk" Version="$(WorkflowVersion)" />
    <PackageReference Include="WorkflowDesigner.WpfSdk" Version="$(WorkflowVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <!-- Developer convenience only: keep the runtime host decoupled from this plugin at compile time,
       but make the sample immediately visible when the full solution is built in Debug. -->
  <Target Name="DeploySamplePluginToWorkflowRuntime"
          AfterTargets="Build"
          Condition="'$(DeployToWorkflowRuntimeOnBuild)' == 'true'">
    <MakeDir Directories="$(WorkflowRuntimePluginDirectory)" />
    <ItemGroup>
      <RuntimePluginFiles Include="$(TargetPath)" />
      <RuntimePluginFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <RuntimePluginFiles Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
      <RuntimePluginFiles Include="$(TargetDir)OpenCvSharp.dll" Condition="Exists('$(TargetDir)OpenCvSharp.dll')" />
      <RuntimePluginFiles Include="$(TargetDir)OpenCvSharpExtern.dll" Condition="Exists('$(TargetDir)OpenCvSharpExtern.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimePluginFiles)"
          DestinationFolder="$(WorkflowRuntimePluginDirectory)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeploySamplePluginToWorkflowDesigner"
          AfterTargets="Build"
          Condition="'$(DeployToWorkflowDesignerOnBuild)' == 'true'">
    <MakeDir Directories="$(WorkflowDesignerPluginDirectory)" />
    <ItemGroup>
      <DesignerPluginFiles Include="$(TargetPath)" />
      <DesignerPluginFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <DesignerPluginFiles Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(DesignerPluginFiles)"
          DestinationFolder="$(WorkflowDesignerPluginDirectory)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
