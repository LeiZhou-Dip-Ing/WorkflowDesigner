<Window x:Class="WorkflowRuntime.OpenCvSamplePlugin.Designer.Wpf.CannyActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canny - External Action Editor"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF252525"
        Foreground="#FFF3F5F7">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SDK Canny Edges"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,3,0,0"
                       Text="This window comes from an external Designer DLL registered by a stable key."
                       Foreground="#FF9EA5AA" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="10" Background="#FF303030" BorderBrush="#FF484848" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Properties exposed by host context" FontWeight="SemiBold" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsReadOnly}"
                                             Padding="4,2" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#FF101010" BorderBrush="#FF484848" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                    <TextBlock Text="No preview yet"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FF888888">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="88" Height="28" Content="Close" IsCancel="True" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
