<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:WorkflowCore.WpfDemo.Models">
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="{Binding Color, Source={StaticResource AppDataGridSelectedRowBrush}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="{Binding Color, Source={StaticResource AppTextBrush}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                         Color="{Binding Color, Source={StaticResource AppTreeItemInactiveSelectedBrush}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                         Color="{Binding Color, Source={StaticResource AppTextBrush}}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="ActionIconTemplate">
            <Grid Width="20" Height="20">
                <Path x:Name="FallbackIcon"
                      Data="M9,1 L3,10 H7 L5,17 L14,7 H10 Z"
                      Fill="{DynamicResource AppAccentBrush}"
                      Width="11" Height="15" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="CachedIcon"
                       Source="{Binding IconImage}"
                       Width="18" Height="18" Stretch="Uniform"
                       Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="CachedIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ActionLogExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderButton"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleSurface" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleSurface" Property="Background" Value="#08000000" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleSurface" Property="Background" Value="#10000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="ExpandedArrow"
                                              Data="M 2,4 L 6,8 L 10,4"
                                              Width="12" Height="12" Stretch="None"
                                              Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Path x:Name="CollapsedArrow"
                                              Data="M 4,2 L 8,6 L 4,10"
                                              Width="12" Height="12" Stretch="None"
                                              Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1" ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ExpandedArrow" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CollapsedArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <StreamGeometry x:Key="WorkflowMethodsIconGeometry">M9,2 H15 V7 H9 Z M12,7 V11 M4,11 H20 M4,11 V15 M12,11 V15 M20,11 V15 M1,15 H7 V21 H1 Z M9,15 H15 V21 H9 Z M17,15 H23 V21 H17 Z</StreamGeometry>
        <StreamGeometry x:Key="WorkflowCSharpScriptIconGeometry">M3,1 H13 L19,7 V23 H3 Z M13,1 V7 H19</StreamGeometry>

        <DataTemplate x:Key="WorkflowDocumentIconTemplate">
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="24" Height="24">
                    <Path x:Name="MethodIcon"
                          Data="{StaticResource WorkflowMethodsIconGeometry}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Margin="1" />
                    <Grid x:Name="ScriptIcon" Visibility="Collapsed" Margin="2,1">
                        <Path Data="{StaticResource WorkflowCSharpScriptIconGeometry}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stretch="Uniform" />
                        <TextBlock Text="C#"
                                   FontSize="6.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3" />
                    </Grid>
                </Grid>
            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static models:WorkflowDocumentKind.CSharpScript}">
                    <Setter TargetName="MethodIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ScriptIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AppCardBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AppFocusBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AppSelectedBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AppPrimaryPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AppDisabledBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AppCardBrush}" />
                                <Setter TargetName="ButtonContent" Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="CompactChromeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DarkScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome"
                                Margin="2"
                                Background="{DynamicResource AppBorderBrush}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AppScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AppScrollThumbPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AppSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DarkVerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="10" Background="{DynamicResource AppPageBrush}">
                <Track x:Name="PART_Track"
                       IsDirectionReversed="True"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Style="{StaticResource DarkScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Style="{StaticResource DarkScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="DarkHorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="10" Background="{DynamicResource AppPageBrush}">
                <Track x:Name="PART_Track"
                       IsDirectionReversed="False"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Style="{StaticResource DarkScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" MinWidth="28" MinHeight="8" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Style="{StaticResource DarkScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppPageBrush}" />
            <Setter Property="Template" Value="{StaticResource DarkVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template" Value="{StaticResource DarkHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource AppDataGridRowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppGridLineBrush}" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppGridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppGridLineBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource AppDataGridRowBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AppDataGridAlternateRowBrush}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style x:Key="WorkflowEditorDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource AppDataGridRowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource AppDataGridAlternateRowBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppDataGridSelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow"
               BasedOn="{StaticResource WorkflowEditorDataGridRowStyle}" />

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppDataGridHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppGridLineBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="WorkflowEditorDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{DynamicResource AppGridLineBrush}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppDataGridSelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell"
               BasedOn="{StaticResource WorkflowEditorDataGridCellStyle}" />

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <ControlTemplate x:Key="AppTopLevelMenuItemTemplate" TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="ItemBackground"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <ContentPresenter x:Name="TopLevelIcon"
                                          ContentSource="Icon"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                </Border>

                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Padding="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Focusable="False">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                    <Setter TargetName="TopLevelIcon" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AppCardBrush}" />
                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AppCardBrush}" />
                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
                    <Setter TargetName="ItemBackground" Property="Background" Value="Transparent" />
                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="AppSubmenuMenuItemTemplate" TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="ItemBackground"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1">
                    <Grid Height="{TemplateBinding Height}"
                          MinWidth="{TemplateBinding MinWidth}"
                          Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter x:Name="IconHost"
                                          ContentSource="Icon"
                                          Width="16"
                                          Height="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <Path x:Name="Checkmark"
                              Data="M1,5 L4,8 L10,1"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"
                              Width="12"
                              Height="10"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
                        <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBlock Grid.Column="2"
                                   Text="{TemplateBinding InputGestureText}"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="28,0,8,0" />
                        <Path x:Name="SubmenuArrow"
                              Grid.Column="3"
                              Data="M1,1 L7,6 L1,11 Z"
                              Fill="{TemplateBinding Foreground}"
                              Width="6"
                              Height="10"
                              Stretch="Uniform"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Popup x:Name="PART_Popup"
                       Placement="Right"
                       HorizontalOffset="-2"
                       VerticalOffset="-3"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Padding="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Focusable="False">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AppCardBrush}" />
                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AppCardBrush}" />
                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
                    <Setter TargetName="ItemBackground" Property="Background" Value="Transparent" />
                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="210" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource AppSubmenuMenuItemTemplate}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Template" Value="{StaticResource AppTopLevelMenuItemTemplate}" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Template" Value="{StaticResource AppTopLevelMenuItemTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="32,4,8,4"
                                Background="{DynamicResource AppGridLineBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Focusable="False">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
