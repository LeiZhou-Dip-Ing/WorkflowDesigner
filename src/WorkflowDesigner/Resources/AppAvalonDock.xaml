<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vs2013="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013">

    <SolidColorBrush x:Key="AppDockBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="AppDockPanelBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="AppDockHoverBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="AppDockActiveBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="AppDockBorderBrush" Color="#FF5B5B5B" />
    <SolidColorBrush x:Key="AppDockTextBrush" Color="#FFF4F8FB" />
    <SolidColorBrush x:Key="AppDockMutedTextBrush" Color="#FFAEB6BE" />
    <SolidColorBrush x:Key="AppDockAccentBrush" Color="#FF62B915" />

    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabSelectedActiveBackground}"
                     Color="{Binding Color, Source={StaticResource AppDockActiveBrush}}" />
    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabSelectedActiveText}"
                     Color="{Binding Color, Source={StaticResource AppDockTextBrush}}" />

    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabSelectedInactiveBackground}"
                     Color="{Binding Color, Source={StaticResource AppDockHoverBrush}}" />
    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabSelectedInactiveText}"
                     Color="{Binding Color, Source={StaticResource AppDockMutedTextBrush}}" />

    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabUnselectedBackground}"
                     Color="{Binding Color, Source={StaticResource AppDockPanelBrush}}" />
    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabUnselectedText}"
                     Color="{Binding Color, Source={StaticResource AppDockMutedTextBrush}}" />

    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}"
                     Color="{Binding Color, Source={StaticResource AppDockHoverBrush}}" />
    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabUnselectedHoveredText}"
                     Color="{Binding Color, Source={StaticResource AppDockTextBrush}}" />

    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabButtonSelectedActiveGlyph}"
                     Color="{Binding Color, Source={StaticResource AppDockTextBrush}}" />
    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabButtonSelectedInactiveGlyph}"
                     Color="{Binding Color, Source={StaticResource AppDockMutedTextBrush}}" />
    <SolidColorBrush x:Key="{x:Static vs2013:ResourceKeys.DocumentWellTabButtonUnselectedTabHoveredGlyph}"
                     Color="{Binding Color, Source={StaticResource AppDockTextBrush}}" />

</ResourceDictionary>
