<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Public extension contract. Keep these keys stable across host redesigns. -->
    <SolidColorBrush x:Key="WorkflowSdkPageBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WorkflowSdkSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WorkflowSdkPanelBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WorkflowSdkBorderBrush" Color="#FFD6E0EA" />
    <SolidColorBrush x:Key="WorkflowSdkTextBrush" Color="#FF172033" />
    <SolidColorBrush x:Key="WorkflowSdkMutedTextBrush" Color="#FF5B6B80" />
    <SolidColorBrush x:Key="WorkflowSdkAccentBrush" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="WorkflowSdkSuccessBrush" Color="#FF16A34A" />
    <SolidColorBrush x:Key="WorkflowSdkWarningBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="WorkflowSdkDangerBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="WorkflowSdkSelectedBrush" Color="#FFEAF3FF" />

    <Style x:Key="WorkflowSdkButtonStyle" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}" />
    <Style x:Key="WorkflowSdkTextBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style x:Key="WorkflowSdkGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource WorkflowSdkTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowSdkBorderBrush}" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Padding" Value="7" />
    </Style>
    <Style x:Key="WorkflowSdkTabControlStyle" TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource WorkflowSdkTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WorkflowSdkPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowSdkBorderBrush}" />
    </Style>
    <Style x:Key="WorkflowSdkTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource WorkflowSdkTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WorkflowSdkPanelBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinWidth" Value="88" />
    </Style>
</ResourceDictionary>
