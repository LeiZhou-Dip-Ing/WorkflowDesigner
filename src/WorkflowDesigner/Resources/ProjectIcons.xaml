<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="ProjectHubIcon">
        <Viewbox Stretch="Uniform">
            <Grid Width="36" Height="36">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Margin="2" CornerRadius="1.5" BorderThickness="2"
                        BorderBrush="{DynamicResource AppPrimaryBrush}" />
                <Border Grid.Column="1" Margin="2" CornerRadius="1.5" BorderThickness="2"
                        BorderBrush="{DynamicResource AppPrimaryBrush}" />
                <Border Grid.Row="1" Margin="2" CornerRadius="1.5" BorderThickness="2"
                        BorderBrush="{DynamicResource AppPrimaryBrush}" />
                <Border Grid.Row="1" Grid.Column="1" Margin="2" CornerRadius="1.5" BorderThickness="2"
                        BorderBrush="{DynamicResource AppPrimaryBrush}" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ProjectFolderIcon">
        <Viewbox Stretch="Uniform">
            <Path Data="M4,37 V8 H18 L23,13 H43 V18 M4,37 H38 L46,18 H10 Z"
                  Width="48"
                  Height="42"
                  Fill="Transparent"
                  Stroke="{DynamicResource AppPrimaryBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Uniform" />
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
