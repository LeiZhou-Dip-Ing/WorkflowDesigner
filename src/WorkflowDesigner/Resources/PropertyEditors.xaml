<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WorkflowCore.WpfDemo.Controls"
                    xmlns:converters="clr-namespace:WorkflowCore.WpfDemo.Converters">
    <converters:InverseBooleanConverter x:Key="PropertyEditorInverseBooleanConverter" />
    <BooleanToVisibilityConverter x:Key="PropertyEditorBooleanToVisibilityConverter" />

    <!-- Dialog property groups use the same chrome and arrow as the original inline property panel. -->
    <Style x:Key="PropertyGroupExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderSite"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="#FF525252"
                                      BorderBrush="#FF686868"
                                      BorderThickness="0,1,0,1"
                                      Foreground="#FF1F2937"
                                      Focusable="False"
                                      HorizontalAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow"
                                                  Width="7"
                                                  Height="7"
                                                  Fill="#FFE1E4E6"
                                                  Stretch="Uniform"
                                                  Data="M1,1 L7,5 L1,9 Z"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                            <ContentPresenter Grid.Column="1"
                                                              Content="{TemplateBinding Content}"
                                                              Margin="0,0,4,0"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Data" Value="M1,2 L9,2 L5,8 Z" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFD5DEE8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite"
                                          Grid.Row="1"
                                          ContentSource="Content"
                                          HorizontalAlignment="Stretch"
                                          Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keep the built-in Action editors visually identical to the original property grid. -->
    <Style x:Key="PropertyCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#FF94A3B8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Path x:Name="CheckMark" Data="M2,7 L5.5,10.5 L13,2.5"
                                  Stroke="#FF1677C8" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="#FF2E3B27" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FF1677C8" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFA6A6A6" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PropertyComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="#FFF1F5F9" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#FFDCECF9" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFDCECF9" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="#FFEAF3FC" />
        <Setter Property="BorderBrush" Value="#FFCBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PropertyComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="OuterBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite" Margin="6,1,3,1" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <TextBox x:Name="PART_EditableTextBox" Margin="4,0,2,0" Padding="2,1"
                                         Foreground="{TemplateBinding Foreground}" Background="Transparent"
                                         BorderThickness="0" VerticalContentAlignment="Center" Visibility="Collapsed" />
                                <ToggleButton Grid.Column="1" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}">
                                                <Path Data="M2,3 L6,7 L10,3" Width="10" Height="7" Stretch="Fill"
                                                      Stroke="#FF475569" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260" Background="#FFFFFFFF" BorderBrush="#FF94A3B8" BorderThickness="1">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="OuterBorder" Property="BorderBrush" Value="#FF1677C8" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PropertyEditorIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" /><Setter Property="Height" Value="23" />
        <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FF334155" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <DataTemplate x:Key="BuiltinPropertyTextTemplate">
        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding Description}" Padding="4,2" BorderThickness="0">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="#FF1F2937" />
                    <Setter Property="Background" Value="#FFEFF4F8" />
                    <Setter Property="BorderBrush" Value="#FFD5DEE8" />
                    <Setter Property="CaretBrush" Value="#FF1F2937" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="#FFE8893A" />
                            <Setter Property="ToolTip" Value="{Binding ValidationError}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
    </DataTemplate>

    <DataTemplate x:Key="BuiltinPropertyNumberTemplate">
        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding Description}" Padding="4,2" BorderThickness="0" />
    </DataTemplate>

    <DataTemplate x:Key="BuiltinPropertyBooleanTemplate">
        <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Style="{StaticResource PropertyCheckBoxStyle}" ClickMode="Press" Focusable="False"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                  IsEnabled="{Binding IsReadOnly, Converter={StaticResource PropertyEditorInverseBooleanConverter}}"
                  ToolTip="{Binding Description}" />
    </DataTemplate>

    <DataTemplate x:Key="BuiltinPropertySelectionTemplate">
        <ComboBox ItemsSource="{Binding EnumValues}" SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                  Style="{StaticResource PropertyComboBoxStyle}" ToolTip="{Binding Description}" Padding="3,1"
                  IsEnabled="{Binding IsReadOnly, Converter={StaticResource PropertyEditorInverseBooleanConverter}}" />
    </DataTemplate>

    <DataTemplate x:Key="BuiltinPropertyJsonTemplate">
        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" FontFamily="Consolas" ToolTip="{Binding Description}"
                 Padding="4,2" BorderThickness="0" />
    </DataTemplate>

    <DataTemplate x:Key="BuiltinPropertyLookupTemplate">
        <Grid ToolTip="{Binding Description}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       Foreground="#FFE55353" VerticalAlignment="Center" Margin="0,0,5,0"
                       ToolTip="{Binding ValidationError}"
                       Visibility="{Binding HasValidationError, Converter={StaticResource PropertyEditorBooleanToVisibilityConverter}}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Suggestions}"
                      SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                      IsEditable="{Binding AllowCustomValue}" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      Padding="3,0" Style="{StaticResource PropertyComboBoxStyle}" BorderThickness="0"
                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource PropertyEditorInverseBooleanConverter}}"
                      ToolTip="{Binding Placeholder}" />
            <Button Grid.Column="2" Content="&#xE710;" Style="{StaticResource PropertyEditorIconButtonStyle}"
                    Command="{Binding CreateValueCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionPropertyPanel}}}"
                    CommandParameter="{Binding}" ToolTip="Create variable"
                    Visibility="{Binding AllowCreate, Converter={StaticResource PropertyEditorBooleanToVisibilityConverter}}" />
            <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource PropertyEditorIconButtonStyle}"
                    Command="{Binding ClearValueCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ActionPropertyPanel}}}"
                    CommandParameter="{Binding}" ToolTip="Clear value"
                    Visibility="{Binding AllowClear, Converter={StaticResource PropertyEditorBooleanToVisibilityConverter}}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
