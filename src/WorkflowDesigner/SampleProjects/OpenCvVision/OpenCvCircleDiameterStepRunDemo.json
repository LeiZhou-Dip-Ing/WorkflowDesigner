            "actionType": "sample.vision.gaussianBlur",
            "uid": "1a118ae2-f408-47d4-8974-fd8dcf729aef",
            "isActive": true,
            "inputImage": "_$grayImage",
            "kernelSize": 7,
            "sigmaX": 1.2,
            "publishPreview": true,
            "outputBindings": { "OutputImage": "_$blurImage" }
          }
        },
        {
          "uid": "8288063c-eab5-4369-ad70-b9ebce58527f",
          "lineNo": 40,
          "sequenceNo": 3,
          "nestingLevel": 0,
          "isActive": true,
          "comment": "STEP 4 - Detect the circle and draw its measured diameter on the result image.",
          "action": {
