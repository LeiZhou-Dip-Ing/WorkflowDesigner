            "uid": "6006f2ec-e9cb-4b71-9db0-e66e88832ebc",
            "isActive": true,
            "inputImage": "_$blurImage",
            "minDist": 40.0,
            "edgeThreshold": 100.0,
            "circleAccumulator": 24.0,
            "minRadius": 60,
            "maxRadius": 120,
            "publishPreview": true,
            "outputBindings": {
              "OutputImage": "_$diameterImage",
              "Found": "_$circleFound",
              "CenterX": "_$centerX",
              "CenterY": "_$centerY",
              "Radius": "_$radiusPx",
              "Diameter": "_$diameterPx"
            }
          }
        }
