            "outputBindings": { "OutputImage": "_$sourceImage" }
          }
        },
        {
          "uid": "06f50b8d-8d34-497b-a6b4-facbb08b74c4",
          "lineNo": 20,
          "sequenceNo": 1,
          "nestingLevel": 0,
          "isActive": true,
          "comment": "STEP 2 - Convert the source to grayscale for circle analysis.",
          "action": {
            "actionId": "93d252af-76b8-46d1-8efe-dcc39773c3ad",
