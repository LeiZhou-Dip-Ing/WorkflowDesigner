<Window x:Class="WorkflowCore.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:avalonControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:docking="clr-namespace:WorkflowCore.WpfDemo.Docking"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:models="clr-namespace:WorkflowCore.WpfDemo.Models"
        xmlns:viewModels="clr-namespace:WorkflowCore.WpfDemo.ViewModels"
        xmlns:views="clr-namespace:WorkflowCore.WpfDemo.Views"
        mc:Ignorable="d"
        Title="Workflow Core Designer" Height="850" Width="1480"
        MinHeight="760" MinWidth="1180"
        Background="#FF1F1F1F"
        Foreground="#FFF0F4F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:MethodEditorViewModel}">
            <views:MethodEditorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CSharpScriptEditorViewModel}">
            <views:CSharpScriptEditorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:DockPaneItem}">
            <Border Background="{StaticResource SurfaceBrush}">
                <ContentControl Content="{Binding Content}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </DataTemplate>

        <Style x:Key="HamburgerRailItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#FF050505" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF777777" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A3A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubmenuMethodItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#FF161616"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF464646" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF383838" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type avalonControls:LayoutDocumentPaneControl}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="{x:Type avalonControls:LayoutDocumentControl}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>

        <Style TargetType="{x:Type avalonControls:LayoutDocumentTabItem}">
            <Setter Property="Background" Value="#FF252525" />
            <Setter Property="Foreground" Value="#FFE9EEF2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Padding" Value="10,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#FF007ACC" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="BorderBrush" Value="#FF007ACC" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF333333" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type avalonControls:TabControlEx}">
            <Setter Property="Background" Value="#FF202020" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style x:Key="DialogCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="#FF343434" />
            <Setter Property="BorderBrush" Value="#FF777777" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Path x:Name="CheckMark"
                                  Data="M2,7 L5.5,10.5 L13,2.5"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="#FF2E3B27" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFA6A6A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputVariableComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="#FF333333" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF4A4A4A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF355A28" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputVariableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="#FF3A3A3A" />
            <Setter Property="BorderBrush" Value="#FF676767" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource InputVariableComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="6,1,3,1"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}">
                                                    <Path Data="M2,3 L6,7 L10,3"
                                                          Width="10"
                                                          Height="7"
                                                          Stretch="Fill"
                                                          Stroke="#FFD5D9DC"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="#FF303030"
                                        BorderBrush="#FF707070"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellHeaderCommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#FFE7E7E7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF303033" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF454549" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartActionCardStyle" TargetType="Button">
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#FF292C30" />
            <Setter Property="BorderBrush" Value="#FF484C51" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF31353A" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF6C737B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF25282C" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF3994FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentProjectButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FF3C4045" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF2D3136" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF252A30" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="#FF3994FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Grid x:Name="ShellGrid"
          DataContext="{Binding ActiveWorkspace}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.HasActiveProject, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF181818"
                BorderBrush="#FF383838"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PROJECT"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF8D8D8D"
                               VerticalAlignment="Center"
                               Margin="0,1,8,0" />
                    <TextBlock Text="{Binding Project.Name, FallbackValue=Untitled Project}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FFF2F2F2"
                               VerticalAlignment="Center"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis" />
                    <Border Width="1"
                            Height="20"
                            Background="#FF484848"
                            Margin="14,0,10,0" />
                    <Button Style="{StaticResource ShellHeaderCommandButtonStyle}"
                            Command="{Binding SaveAllWorkflowCommand}"
                            AutomationProperties.Name="Save project"
                            ToolTip="Save all methods, scripts, and Project structure changes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE105;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="Save project" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1"
                            Height="20"
                            Background="#FF484848"
                            Margin="10,0" />
                    <Button Style="{StaticResource ShellHeaderCommandButtonStyle}"
                            Command="{Binding ImportProjectJsonCommand}"
                            AutomationProperties.Name="Import project"
                            ToolTip="Replace the current Project from a Workflow Project JSON file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="Import project" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ShellHeaderCommandButtonStyle}"
                            Command="{Binding DataContext.CloseProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.Name="Close project"
                            ToolTip="Close the current Project and return to the Start Page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="Close project" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              x:Name="RootGrid"
              PreviewMouseDown="RootGridOnPreviewMouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ExplorerWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ExplorerRail"
                Grid.Column="0"
                Background="#FF050505"
                BorderBrush="#FF303030"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Top"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ToggleExplorerCommand}"
                        Content="&#xE700;"
                        Width="48"
                        Height="48"
                        FontSize="18"
                        Margin="0"
                        HorizontalAlignment="Left"
                        ToolTip="Menu" />

                <Button DockPanel.Dock="Bottom"
                        Command="{Binding NewMethodCommand}"
                        Style="{StaticResource SidebarActionButtonStyle}"
                        ToolTip="Create . . .">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="#FFE8EEF2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Create . . ."
                                   FontSize="16"
                                   Foreground="#FFFFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <Button DockPanel.Dock="Bottom"
                        Command="{Binding DeployWorkflowCommand}"
                        Style="{StaticResource SidebarActionButtonStyle}"
                        ToolTip="Deploy the complete saved local Project">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE898;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFE8EEF2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Deploy Project"
                                   FontSize="14"
                                   Foreground="#FFFFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <Button DockPanel.Dock="Bottom"
                        Command="{Binding DownloadWorkflowCommand}"
                        Style="{StaticResource SidebarActionButtonStyle}"
                        ToolTip="Download Runtime Project">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFE8EEF2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Download Project"
                                   FontSize="14"
                                   Foreground="#FFFFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <ListBox ItemsSource="{Binding HamburgerMenuItems}"
                         SelectedItem="{Binding SelectedHamburgerMenuItem}"
                         ItemContainerStyle="{StaticResource HamburgerRailItemStyle}"
                         Background="#FF050505"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectHamburgerMenuCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    ToolTip="{Binding Title}">
                                <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding IconKey}"
                                          ContentTemplate="{StaticResource DocumentIconTemplate}"
                                          Foreground="#FFE8EEF2"
                                          Width="28"
                                          Height="26"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="16"
                                               Foreground="#FFFFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Popup IsOpen="{Binding IsCreateMenuOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Relative"
               HorizontalOffset="{Binding ExplorerPanelWidth}"
               VerticalOffset="0"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="300"
                    Height="{Binding ActualHeight, ElementName=RootGrid}"
                    Background="#FF2B2B2B"
                    BorderBrush="#FF111111"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Create"
                               Margin="24,0,12,0"
                               FontSize="18"
                               Foreground="#FFFFFFFF"
                               VerticalAlignment="Center" />

                    <Button Grid.Row="1"
                            Command="{Binding SelectCreateItemCommand}"
                            CommandParameter="Method"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="22,0"
                            HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF424242" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF575757" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{x:Static models:DocumentIconKeys.Method}"
                                            ContentTemplate="{StaticResource DocumentIconTemplate}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Width="22"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1"
                                       Text="New Method"
                                       FontSize="14"
                                       Foreground="#FFFFFFFF"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="2"
                            Command="{Binding SelectCreateItemCommand}"
                            CommandParameter="CSharpScript"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="22,0"
                            HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF424242" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF575757" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{x:Static models:DocumentIconKeys.CSharpScript}"
                                            ContentTemplate="{StaticResource DocumentIconTemplate}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Width="22"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1"
                                       Text="CSharp Script"
                                       FontSize="14"
                                       Foreground="#FFFFFFFF"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                </Grid>
            </Border>
        </Popup>

        <Border x:Name="MethodsSubmenu"
                Grid.Column="1"
                Panel.ZIndex="20"
                Width="220"
                HorizontalAlignment="Left"
                Background="#FF2B2B2B"
                BorderBrush="#FF111111"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsMethodsSubmenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="12,0,4,0">
                    <TextBlock Text="Methods"
                               FontSize="16"
                               Foreground="#FFFFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="(&#x23FB;: Init, &#x25B7;: Startable)"
                               Foreground="#FFD0D0D0"
                               FontSize="10"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Methods}"
                                 SelectedItem="{Binding SelectedMethod}"
                                 ItemContainerStyle="{StaticResource SubmenuMethodItemStyle}"
                                 Background="#FF2B2B2B"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenMethodCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="16,0,14,0"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete method"
                                                          Command="{Binding PlacementTarget.Tag.DeleteMethodCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{x:Static models:DocumentIconKeys.Method}"
                                                            ContentTemplate="{StaticResource DocumentIconTemplate}"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            Width="17"
                                                            Height="19"
                                                            HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#FFFFFFFF"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="&#x25B7;" Foreground="#FFFFFFFF" FontSize="12" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="ScriptsSubmenu"
                Grid.Column="1"
                Panel.ZIndex="20"
                Width="220"
                HorizontalAlignment="Left"
                Background="#FF2B2B2B"
                BorderBrush="#FF111111"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsScriptsSubmenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="CSharp Scripts"
                           FontSize="16"
                           Foreground="#FFFFFFFF"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Scripts}"
                                 ItemContainerStyle="{StaticResource SubmenuMethodItemStyle}"
                                 Background="#FF2B2B2B"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenScriptCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,0,14,0"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete local CSharp script"
                                                          Command="{Binding PlacementTarget.Tag.DeleteScriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{x:Static models:DocumentIconKeys.CSharpScript}"
                                                            ContentTemplate="{StaticResource DocumentIconTemplate}"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            Width="17"
                                                            Height="20"
                                                            HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayFileName}" FontSize="12"
                                                       Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Column="1" Background="#FF202020">
            <avalonDock:DockingManager x:Name="EditorDockingManager"
                                       Background="#FF202020"
                                       BorderBrush="{StaticResource BorderBrushSoft}"
                                       BorderThickness="0"
                                       DocumentsSource="{Binding OpenedEditors}"
                                       ActiveContent="{Binding SelectedDockPane, Mode=TwoWay}"
                                       docking:DockingBehavior.SelectedEditor="{Binding SelectedDockPane, Mode=TwoWay}">
                <avalonDock:DockingManager.Theme>
                    <docking:Vs2013DarkDockTheme />
                </avalonDock:DockingManager.Theme>
                <avalonDock:DockingManager.DocumentHeaderTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <ContentControl ContentTemplate="{StaticResource DocumentIconTemplate}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Width="17"
                                            Height="18"
                                            Margin="0,0,6,0">
                                <ContentControl.Content>
                                    <PriorityBinding>
                                        <Binding Path="Content.IconKey" />
                                        <Binding Path="Model.Content.IconKey" />
                                        <Binding Path="IconKey" />
                                    </PriorityBinding>
                                </ContentControl.Content>
                            </ContentControl>
                            <TextBlock>
                                <TextBlock.Text>
                                    <PriorityBinding>
                                        <Binding Path="Content.Title" />
                                        <Binding Path="Model.Content.Title" />
                                        <Binding Path="Title" />
                                    </PriorityBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </avalonDock:DockingManager.DocumentHeaderTemplate>
                <avalonDock:DockingManager.Layout>
                    <layout:LayoutRoot>
                        <layout:LayoutPanel Orientation="Horizontal">
                            <layout:LayoutDocumentPane />
                        </layout:LayoutPanel>
                    </layout:LayoutRoot>
                </avalonDock:DockingManager.Layout>
            </avalonDock:DockingManager>
        </DockPanel>

        <Grid Grid.ColumnSpan="2"
              Background="#99000000"
              Visibility="{Binding IsCreateMethodDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="420"
                    Background="#FF2B2B2B"
                    BorderBrush="#FF696969"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding CreateDialogTitle}"
                               FontSize="24"
                               Foreground="#FFFFFFFF"
                               Margin="0,0,0,18" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding CreateNameLabel}"
                               Foreground="#FFE9EEF2"
                               FontSize="14"
                               Margin="0,0,0,6" />
                    <TextBox Grid.Row="2"
                             Text="{Binding NewMethodName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             MinHeight="38"
                             Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3"
                               Text="{Binding CreateMethodError}"
                               Foreground="#FFFF8A80"
                               FontSize="13"
                               MinHeight="22"
                               Margin="0,0,0,14" />

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelCreateMethodCommand}"
                                MinWidth="88" />
                        <Button Content="OK"
                                Command="{Binding ConfirmCreateMethodCommand}"
                                MinWidth="88"
                                Background="#FF007ACC"
                                BorderBrush="#FF178FDB" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Background="#99000000"
              Visibility="{Binding IsRenameVariableDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="430"
                    Background="#FF2B2B2B"
                    BorderBrush="#FF696969"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Rename variable"
                               FontSize="24"
                               Foreground="#FFFFFFFF"
                               Margin="0,0,0,18" />
                    <TextBlock Grid.Row="1"
                               Text="New variable name"
                               Foreground="#FFE9EEF2"
                               FontSize="14"
                               Margin="0,0,0,6" />
                    <TextBox Grid.Row="2"
                             Text="{Binding RenameVariableName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             MinHeight="38"
                             Margin="0,0,0,8" />
                    <CheckBox Grid.Row="3"
                              Content="Rename this global variable across all methods"
                              IsChecked="{Binding RenameVariableAcrossAllMethods}"
                              Visibility="{Binding CanRenameVariableAcrossAllMethods, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Foreground="#FFE9EEF2"
                              Margin="0,4,0,8" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding RenameVariableError}"
                               Foreground="#FFFF8A80"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               Margin="0,0,0,14" />

                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelRenameVariableCommand}"
                                MinWidth="88" />
                        <Button Content="OK"
                                Command="{Binding ConfirmRenameVariableCommand}"
                                MinWidth="88"
                                Background="#FF007ACC"
                                BorderBrush="#FF178FDB" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="120"
              Background="#B3000000"
              Visibility="{Binding IsDeploymentComparisonOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Margin="48"
                    Background="#FF252525"
                    BorderBrush="#FF696969"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseDeploymentComparisonCommand}"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="34"
                                Height="30"
                                ToolTip="Close comparison" />
                        <TextBlock Text="Local / Runtime comparison"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFFFF"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DeploymentComparisonSummary}"
                               Foreground="#FFD5DDE5"
                               FontSize="13"
                               Margin="0,10,0,12"
                               TextWrapping="Wrap" />

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DeploymentDifferences}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="#FF202020"
                              BorderBrush="#FF4A4A4A"
                              Foreground="#FFF1F4F7">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FF292929" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Change}" Value="Modified">
                                        <Setter Property="Background" Value="#FF44371F" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Change}" Value="Local only">
                                        <Setter Property="Background" Value="#FF1F3E2B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Change}" Value="Runtime only">
                                        <Setter Property="Background" Value="#FF40252A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="110" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="320" />
                            <DataGridTemplateColumn Header="Local working copy" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocalValue}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Margin="6,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active Runtime" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RuntimeValue}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Margin="6,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Command="{Binding DeployWorkflowCommand}"
                                MinWidth="190"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Deploy saved local Project" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DownloadWorkflowCommand}"
                                MinWidth="190"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Download Runtime Project" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CloseDeploymentComparisonCommand}"
                                Content="Close"
                                MinWidth="90" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="#B3000000"
              Visibility="{Binding IsSynchronizingRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="430"
                    Background="#FF2B2B2B"
                    BorderBrush="#FF696969"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Synchronizing Workflow Runtime"
                               FontSize="22"
                               Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />
                    <ProgressBar Height="8"
                                 IsIndeterminate="True"
                                 Margin="0,0,0,16" />
                    <TextBlock Text="{Binding RuntimeSynchronizationMessage}"
                               Foreground="#FFD9E2EA"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>

    <Grid Background="#FF202328">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStartPageVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF191C20" BorderBrush="#FF3A3E43" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                <Border Width="34" Height="34" BorderBrush="#FF3994FF" BorderThickness="2" CornerRadius="5">
                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                               Foreground="#FF55A4FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Workflow Core Designer" FontSize="22" Foreground="#FFF4F6F8" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="620" />
                <ColumnDefinition Width="3*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="40,30,36,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Recent Projects" FontSize="23" FontWeight="SemiBold" Foreground="#FFF4F6F8" />
                <Grid Grid.Row="1" Width="540" Height="38" Margin="0,18,0,18" HorizontalAlignment="Left">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
         Padding="37,0,10,0"
         FontSize="14"
         VerticalContentAlignment="Center" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="#FFB5BDC6" Margin="12,0,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="Search project name or path"
           Foreground="#FF8E969F"
           Margin="38,0,0,0"
           VerticalAlignment="Center"
           IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentProjectGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}" FontSize="15" Foreground="#FFE3E7EB"
                                                   FontWeight="SemiBold" Margin="4,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding Projects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource RecentProjectButtonStyle}"
                                                            Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="52" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="150" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="27"
                                                                       Foreground="#FFD9DEE3" HorizontalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,18,0">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" Foreground="#FFF1F3F5"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="#FFAAB2BB"
                                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding FullPath}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LastOpenedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                                                       Foreground="#FFBEC5CC" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No recent projects" FontSize="16" Foreground="#FF9FA7AF"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Border Grid.Column="1" BorderBrush="#FF3A3E43" BorderThickness="1,0,0,0" Padding="36,30">
                <StackPanel>
                    <TextBlock Text="Get Started" FontSize="23" FontWeight="SemiBold" Foreground="#FFF4F6F8" Margin="0,0,0,28" />
                    <Button Style="{StaticResource StartActionCardStyle}" Command="{Binding NewProjectCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" BorderBrush="#FF3994FF" BorderThickness="2" CornerRadius="7">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FF55A4FF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="New Project" FontSize="18" Foreground="#FFF4F6F8" />
                                <TextBlock Text="Create a new project file" FontSize="13" Foreground="#FFADB5BE" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFD6DBE0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StartActionCardStyle}" Command="{Binding OpenProjectCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#FF55A4FF"
                                       HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Open Project" FontSize="18" Foreground="#FFF4F6F8" />
                                <TextBlock Text="Load a project from a local file" FontSize="13" Foreground="#FFADB5BE" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFD6DBE0" />
                        </Grid>
                    </Button>
                    <TextBlock Text="{Binding StartPageError}" Foreground="#FFFF9292" TextWrapping="Wrap" Margin="4,8,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStartPageError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF191C20" BorderBrush="#FF3A3E43" BorderThickness="0,1,0,0">
          
        </Border>
    </Grid>

    <Grid Panel.ZIndex="300" Background="#A8000000">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMissingProjectDialogOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Width="500" Background="#FF292D32" BorderBrush="#FF626970" BorderThickness="1"
                CornerRadius="5" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Project file not found" FontSize="20" FontWeight="SemiBold" Foreground="#FFF4F6F8" />
                <TextBlock Text="This recent project no longer exists at the saved location. Remove it from Recent Projects?"
                           Foreground="#FFD1D7DD" TextWrapping="Wrap" Margin="0,14,0,8" />
                <TextBlock Text="{Binding MissingRecentProject.FullPath}" Foreground="#FF9FA8B1" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Keep" Command="{Binding KeepMissingProjectCommand}" MinWidth="88" />
                    <Button Content="Remove" Command="{Binding RemoveMissingProjectCommand}" MinWidth="88"
                            Background="#FF2E75B6" BorderBrush="#FF4A91D1" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
