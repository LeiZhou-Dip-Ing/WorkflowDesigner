                Panel.ZIndex="20"
                Width="220"
                HorizontalAlignment="Left"
                Background="{DynamicResource AppSidebarBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsMethodsSubmenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="12,0,4,0">
                    <TextBlock Text="Methods"
                               FontSize="16"
                               Foreground="{DynamicResource AppTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="(&#x23FB;: Init, &#x25B7;: Startable)"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Methods}"
                                 SelectedItem="{Binding SelectedMethod}"
                                 ItemContainerStyle="{StaticResource SubmenuMethodItemStyle}"
                                 Background="{DynamicResource AppSidebarBrush}"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenMethodCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="16,0,14,0"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete method"
                                                          Command="{Binding PlacementTarget.Tag.DeleteMethodCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{x:Static models:DocumentIconKeys.Method}"
                                                            ContentTemplate="{StaticResource DocumentIconTemplate}"
                                                            Foreground="{DynamicResource AccentBrush}"
                                                            Width="17"
                                                            Height="19"
                                                            HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource AppTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="&#x25B7;" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="ScriptsSubmenu"
                Grid.Column="1"
                Panel.ZIndex="20"
                Width="220"
                HorizontalAlignment="Left"
                Background="{DynamicResource AppSidebarBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsScriptsSubmenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="CSharp Scripts"
                           FontSize="16"
                           Foreground="{DynamicResource AppTextBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Scripts}"
                                 ItemContainerStyle="{StaticResource SubmenuMethodItemStyle}"
                                 Background="{DynamicResource AppSidebarBrush}"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenScriptCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="12,0,14,0"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete local CSharp script"
                                                          Command="{Binding PlacementTarget.Tag.DeleteScriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{x:Static models:DocumentIconKeys.CSharpScript}"
                                                            ContentTemplate="{StaticResource DocumentIconTemplate}"
                                                            Foreground="{DynamicResource AccentBrush}"
                                                            Width="17"
                                                            Height="20"
                                                            HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayFileName}" FontSize="12"
                                                       Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Column="1" Background="{DynamicResource AppPageBrush}">
            <avalonDock:DockingManager x:Name="EditorDockingManager"
                                       Background="{DynamicResource AppPageBrush}"
                                       BorderBrush="{DynamicResource BorderBrushSoft}"
                                       BorderThickness="0"
                                       DocumentsSource="{Binding OpenedEditors}"
                                       ActiveContent="{Binding SelectedDockPane, Mode=TwoWay}"
                                       docking:DockingBehavior.SelectedEditor="{Binding SelectedDockPane, Mode=TwoWay}">
                <avalonDock:DockingManager.Theme>
                    <docking:AutomationProDockTheme />
                </avalonDock:DockingManager.Theme>
                <avalonDock:DockingManager.DocumentHeaderTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <ContentControl ContentTemplate="{StaticResource DocumentIconTemplate}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Width="17"
                                            Height="18"
                                            Margin="0,0,6,0">
                                <ContentControl.Content>
                                    <PriorityBinding>
                                        <Binding Path="Content.IconKey" />
                                        <Binding Path="Model.Content.IconKey" />
                                        <Binding Path="IconKey" />
                                    </PriorityBinding>
                                </ContentControl.Content>
                            </ContentControl>
                            <TextBlock>
                                <TextBlock.Text>
                                    <PriorityBinding>
                                        <Binding Path="Content.Title" />
                                        <Binding Path="Model.Content.Title" />
                                        <Binding Path="Title" />
                                    </PriorityBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </avalonDock:DockingManager.DocumentHeaderTemplate>
                <avalonDock:DockingManager.Layout>
                    <layout:LayoutRoot>
                        <layout:LayoutPanel Orientation="Horizontal">
                            <layout:LayoutDocumentPane />
                        </layout:LayoutPanel>
                    </layout:LayoutRoot>
                </avalonDock:DockingManager.Layout>
            </avalonDock:DockingManager>
        </DockPanel>

        <Grid Grid.ColumnSpan="2"
              Background="#99000000"
              Visibility="{Binding IsCreateMethodDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="420"
                    Background="{DynamicResource AppSidebarBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding CreateDialogTitle}"
                               FontSize="24"
                               Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,0,0,18" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding CreateNameLabel}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="14"
                               Margin="0,0,0,6" />
                    <TextBox Grid.Row="2"
                             Text="{Binding NewMethodName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             MinHeight="38"
                             Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3"
                               Text="{Binding CreateMethodError}"
                               Foreground="{DynamicResource AppDangerBrush}"
                               FontSize="13"
                               MinHeight="22"
                               Margin="0,0,0,14" />

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelCreateMethodCommand}"
                                MinWidth="88" />
                        <Button Content="OK"
                                Command="{Binding ConfirmCreateMethodCommand}"
                                MinWidth="88"
                                Background="#FF007ACC"
                                BorderBrush="#FF178FDB" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Background="#99000000"
              Visibility="{Binding IsRenameVariableDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="430"
                    Background="{DynamicResource AppSidebarBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Rename variable"
                               FontSize="24"
                               Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,0,0,18" />
                    <TextBlock Grid.Row="1"
                               Text="New variable name"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="14"
                               Margin="0,0,0,6" />
                    <TextBox Grid.Row="2"
                             Text="{Binding RenameVariableName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             MinHeight="38"
                             Margin="0,0,0,8" />
                    <CheckBox Grid.Row="3"
                              Content="Rename this global variable across all methods"
                              IsChecked="{Binding RenameVariableAcrossAllMethods}"
                              Visibility="{Binding CanRenameVariableAcrossAllMethods, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Foreground="{DynamicResource AppMutedTextBrush}"
                              Margin="0,4,0,8" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding RenameVariableError}"
                               Foreground="{DynamicResource AppDangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               Margin="0,0,0,14" />

                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelRenameVariableCommand}"
                                MinWidth="88" />
                        <Button Content="OK"
                                Command="{Binding ConfirmRenameVariableCommand}"
                                MinWidth="88"
                                Background="#FF007ACC"
                                BorderBrush="#FF178FDB" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="120"
              Background="#B3000000"
              Visibility="{Binding IsDeploymentComparisonOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Margin="48"
                    Background="{DynamicResource AppDataGridHeaderBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseDeploymentComparisonCommand}"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="34"
                                Height="30"
                                ToolTip="Close comparison" />
                        <TextBlock Text="Local / Runtime comparison"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DeploymentComparisonSummary}"
                               Foreground="#FFD5DDE5"
                               FontSize="13"
                               Margin="0,10,0,12"
                               TextWrapping="Wrap" />

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DeploymentDifferences}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource AppPageBrush}"
                              BorderBrush="{DynamicResource AppSelectedBrush}"
                              Foreground="#FFF1F4F7">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FF292929" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Change}" Value="Modified">
                                        <Setter Property="Background" Value="#FF44371F" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Change}" Value="Local only">
                                        <Setter Property="Background" Value="#FF1F3E2B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Change}" Value="Runtime only">
                                        <Setter Property="Background" Value="#FF40252A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="110" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="320" />
                            <DataGridTemplateColumn Header="Local working copy" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocalValue}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Margin="6,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active Runtime" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RuntimeValue}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Margin="6,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Command="{Binding DeployWorkflowCommand}"
                                MinWidth="190"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Deploy saved local Project" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DownloadWorkflowCommand}"
                                MinWidth="190"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Download Runtime Project" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CloseDeploymentComparisonCommand}"
                                Content="Close"
                                MinWidth="90" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="#B3000000"
              Visibility="{Binding IsSynchronizingRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="430"
                    Background="{DynamicResource AppSidebarBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Synchronizing Workflow Runtime"
                               FontSize="22"
                               Foreground="{DynamicResource AppTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />
                    <ProgressBar Height="8"
                                 IsIndeterminate="True"
                                 Margin="0,0,0,16" />
                    <TextBlock Text="{Binding RuntimeSynchronizationMessage}"
                               Foreground="#FFD9E2EA"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>

    <Grid x:Name="ProjectHubOverlay"
          Grid.Row="1"
          Background="{DynamicResource AppPageBrush}"
          Margin="0,164,0,0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProjectHubVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource AppPageBrush}" BorderBrush="{DynamicResource AppCardBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0">
                <Button DockPanel.Dock="Right"
                        Command="{Binding HideProjectHubCommand}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Width="36"
                        Height="36"
                        Margin="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTip="Close Project Hub" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl ContentTemplate="{StaticResource ProjectHubIcon}" Width="34" Height="34" />
                    <TextBlock Text="Project Hub" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}" Margin="15,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="380" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="30,28,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Recent Projects" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <Grid Grid.Row="1" Width="540" Height="38" Margin="0,18,0,18" HorizontalAlignment="Left">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
         Padding="37,0,10,0"
         FontSize="14"
         VerticalContentAlignment="Center" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource AppMutedTextBrush}" Margin="12,0,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="Search project name or path"
           Foreground="{DynamicResource AppMutedTextBrush}"
           Margin="38,0,0,0"
           VerticalAlignment="Center"
           IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentProjectGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Name}" FontSize="15" Foreground="{DynamicResource AppTextBrush}"
                                                   FontWeight="SemiBold" Margin="4,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding Projects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource RecentProjectButtonStyle}"
                                                            Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="150" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl ContentTemplate="{StaticResource ProjectFolderIcon}"
                                                                            Width="44" Height="40"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,18,0">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AppTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"
                                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding FullPath}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LastOpenedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                                                       FontSize="13" Margin="0,0,16,0"
                                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No recent projects" FontSize="16" Foreground="{DynamicResource AppMutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource AppBorderBrush}" />
            <Border Grid.Column="2" Padding="24,28">
                <StackPanel>
                    <TextBlock Text="Get Started" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,28" />
                    <Button Style="{StaticResource StartActionCardStyle}" Command="{Binding NewProjectCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" BorderBrush="{DynamicResource AppPrimaryBrush}" BorderThickness="2" CornerRadius="7">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AppPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="New Project" FontSize="18" Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock Text="Create a new project file" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AppTextBrush}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StartActionCardStyle}" Command="{Binding OpenProjectCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <ContentControl ContentTemplate="{StaticResource ProjectFolderIcon}"
                                            Width="46" Height="42"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Open Project" FontSize="18" Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock Text="Load a project from a local file" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Margin="0,7,0,0" TextWrapping="NoWrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AppTextBrush}" />
                        </Grid>
                    </Button>
                    <TextBlock Text="{Binding StartPageError}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" Margin="4,8,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStartPageError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
          
        </Border>
    </Grid>

    <Grid Grid.Row="1" Panel.ZIndex="300" Background="#A8000000">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMissingProjectDialogOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Width="500" Background="{DynamicResource AppPanelBrush}" BorderBrush="#FF626970" BorderThickness="1"
                CornerRadius="5" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Project file not found" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="This recent project no longer exists at the saved location. Remove it from Recent Projects?"
                           Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,14,0,8" />
                <TextBlock Text="{Binding MissingRecentProject.FullPath}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Keep" Command="{Binding KeepMissingProjectCommand}" MinWidth="88" />
                    <Button Content="Remove" Command="{Binding RemoveMissingProjectCommand}" MinWidth="88"
                            Background="#FF2E75B6" BorderBrush="#FF4A91D1" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
