<UserControl x:Class="WorkflowCore.WpfDemo.Views.CSharpScriptEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:WorkflowCore.WpfDemo.Controls"
             Background="#FF1E1E1E"
             Foreground="#FF1E293B"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="ScriptToolbarSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="5,7" />
            <Setter Property="Background" Value="#FFE2E8F0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScriptToolbarIconStyle" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.45" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Stroke" Value="#FF747A7E" />
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScriptToolbarSaveIconStyle" TargetType="Path" BasedOn="{StaticResource ScriptToolbarIconStyle}">
            <Setter Property="Data" Value="M2,2 H13 L16,5 V16 H2 Z M5,2 V7 H12 V2 M5,16 V10 H13 V16" />
        </Style>
        <Style x:Key="ScriptToolbarRunIconStyle" TargetType="Path" BasedOn="{StaticResource ScriptToolbarIconStyle}">
            <Setter Property="Data" Value="M5,3 L15,9 L5,15 Z" />
        </Style>
        <Style x:Key="ScriptToolbarUndoIconStyle" TargetType="Path" BasedOn="{StaticResource ScriptToolbarIconStyle}">
            <Setter Property="Data" Value="M7,4 L3,8 L7,12 M3,8 H10 C14,8 16,10 16,14" />
        </Style>
        <Style x:Key="ScriptToolbarDeployIconStyle" TargetType="Path" BasedOn="{StaticResource ScriptToolbarIconStyle}">
            <Setter Property="Data" Value="M5,14 H3.5 C1.8,14 1,12.8 1,11.3 C1,9.7 2.2,8.5 3.8,8.5 C4.2,5.8 6.2,4 9,4 C11.5,4 13.4,5.4 14,7.7 C15.8,7.8 17,9 17,10.8 C17,12.6 15.8,14 14,14 H12 M9,14 V6 M6,9 L9,6 L12,9" />
        </Style>
        <Style x:Key="ScriptToolbarCompareIconStyle" TargetType="Path" BasedOn="{StaticResource ScriptToolbarIconStyle}">
            <Setter Property="Data" Value="M3,6 H14 M11,3 L14,6 L11,9 M15,12 H4 M7,9 L4,12 L7,15" />
        </Style>
        <Style x:Key="ScriptToolbarExportIconStyle" TargetType="Path" BasedOn="{StaticResource ScriptToolbarIconStyle}">
            <Setter Property="Data" Value="M9,3 H16 V10 M16,3 L8,11 M13,15 H3 V5 H8" />
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="8,5,0,5" />
        </Style>
        <Style x:Key="DiagnosticsChromeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactChromeButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="#FFC9C9C9" />
            <Setter Property="ToolTipService.ShowDuration" Value="10000" />
        </Style>
        <Style x:Key="DiagnosticsStatusButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactChromeButtonStyle}">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Foreground" Value="#FF64748B" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="DiagnosticGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="RowBackground" Value="#FFF1F5F9" />
            <Setter Property="AlternatingRowBackground" Value="#FF292929" />
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Visibility" Value="Visible" />
            <EventSetter Event="MouseDoubleClick" Handler="DiagnosticsGridOnMouseDoubleClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiagnosticsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#FFF1F5F9"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="0,0,0,1">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <Button Style="{StaticResource DiagnosticsChromeButtonStyle}"
                                                ToolTip="Collapse diagnostics"
                                                Click="ToggleDiagnosticsPanelOnClick">
                                            <Path Data="M3,10 L8,5 L13,10"
                                                  Width="12"
                                                  Height="8"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Button>
                                        <Button Style="{StaticResource DiagnosticsChromeButtonStyle}"
                                                ToolTip="Close diagnostics"
                                                Click="CloseDiagnosticsPanelOnClick">
                                            <Path Data="M3,3 L13,13 M13,3 L3,13"
                                                  Width="11"
                                                  Height="11"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                    <TabPanel IsItemsHost="True"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Bottom" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Background="#FFF1F5F9">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DiagnosticsTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF64748B" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="38">
                            <Border x:Name="TabBackground"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SelectedLine"
                                    Height="2"
                                    Background="#FF1593E6"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FF1677C8" />
                                <Setter TargetName="SelectedLine" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DiagnosticsHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
        </Style>
        <Style x:Key="DiagnosticsCountBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DiagnosticsEmptyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF64748B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Z"
                    Modifiers="Control"
                    Command="{Binding Owner.UndoCommand}"
                    CommandParameter="{Binding}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="DiagnosticsRow" Height="190" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="320" MinWidth="245" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="#FFF1F5F9"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Style="{StaticResource StatusPill}">
                        <TextBlock Text="{Binding RuntimeStatus}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <TextBlock Text="{Binding PublicationStatus}" FontSize="11" />
                    </Border>
                </StackPanel>
                <Menu Padding="4,0" FontSize="12">
                    <MenuItem Header="Save script" Padding="6,2"
                              Command="{Binding SaveScriptCommand}"
                              ToolTip="Save the script into the current Project">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource ScriptToolbarSaveIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Undo" Padding="6,2"
                              Command="{Binding Owner.UndoCommand}"
                              CommandParameter="{Binding}"
                              InputGestureText="Ctrl+Z">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource ScriptToolbarUndoIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Run" Padding="6,2" Command="{Binding RunScriptCommand}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource ScriptToolbarRunIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource ScriptToolbarSeparatorStyle}" />
                    <MenuItem Header="Deploy script" Padding="6,2" Command="{Binding DeployScriptCommand}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource ScriptToolbarDeployIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Compare" Padding="6,2" Command="{Binding CompareScriptCommand}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource ScriptToolbarCompareIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource ScriptToolbarSeparatorStyle}" />
                    <MenuItem Header="Export" Padding="6,2" Command="{Binding ExportScriptCommand}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource ScriptToolbarExportIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource ScriptToolbarSeparatorStyle}" />
                    <MenuItem Header="Manage Script Libraries..." Padding="6,2"
                              Command="{Binding Owner.ManageScriptLibrariesCommand}" />
                </Menu>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FF3B331E" BorderBrush="#FF756331" BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMissingNamespaceSuggestion}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add reference"
                            Command="{Binding AddSuggestedLibraryCommand}"
                            Padding="10,3" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding MissingNamespaceSuggestionText}"
                               Foreground="#FFFFD970" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <avalonEdit:TextEditor x:Name="ScriptEditor"
                                   Grid.Row="1"
                                   FontFamily="Cascadia Code,Consolas"
                                   FontSize="13.5"
                                   ShowLineNumbers="True"
                                   SyntaxHighlighting="{x:Null}"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   controls:AvalonEditTextBinding.BoundText="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Border Grid.Row="2" Background="#FFF1F5F9" BorderBrush="#FFF8FAFC" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0">
                    <TextBlock Text="{Binding CaretLine, StringFormat=Ln {0}}" FontSize="11" Foreground="#FF64748B" Margin="8,0" />
                    <TextBlock Text="{Binding CaretColumn, StringFormat=Col {0}}" FontSize="11" Foreground="#FF64748B" Margin="8,0" />
                    <TextBlock Text="UTF-8" FontSize="11" Foreground="#FF64748B" Margin="8,0" />
                    <TextBlock Text="CRLF" FontSize="11" Foreground="#FF64748B" Margin="8,0" />
                    <TextBlock Text="C#" FontSize="11" Foreground="#FF64748B" Margin="8,0" />
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Background="#FFEFF4F8" />

        <Border Grid.Row="1" Grid.Column="2"
                Background="#FF292929"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="40" Background="#FFFFFFFF" BorderBrush="#FF505050" BorderThickness="0,0,0,1">
                    <TextBlock Text="Test Script" FontSize="14" FontWeight="SemiBold" Margin="14,0" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="Inputs" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding TypeName}"
                                                       Foreground="#FF64748B" FontSize="11"
                                                       HorizontalAlignment="Right" Margin="12,0,0,0" />
                                        </Grid>
                                        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Description}" Foreground="#FF64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,2,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding RunScriptCommand}" Background="#FF417E24" BorderBrush="#FF5FAE32">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" />
                                    <TextBlock Text="Run" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding ResetTestValuesCommand}" Content="Reset" />
                        </Grid>
                        <Separator Background="#FF505050" />
                        <TextBlock Text="Outputs" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,10" />
                        <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding TypeName}"
                                                       Foreground="#FF64748B" FontSize="11"
                                                       HorizontalAlignment="Right" Margin="12,0,0,0" />
                                        </Grid>
                                        <TextBox Text="{Binding ValueText, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border x:Name="DiagnosticsPanel"
                Grid.Row="2" Grid.ColumnSpan="3"
                Background="#FFF1F5F9"
                BorderBrush="#FFE2E8F0"
                BorderThickness="0,1,0,0">
            <TabControl Style="{StaticResource DiagnosticsTabControlStyle}"
                        ItemContainerStyle="{StaticResource DiagnosticsTabItemStyle}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Diagnostics" Style="{StaticResource DiagnosticsHeaderTextStyle}" />
                            <Border Style="{StaticResource DiagnosticsCountBadgeStyle}">
                                <TextBlock Text="{Binding Diagnostics.Count}" FontSize="11" Foreground="#FF64748B" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock Text="No diagnostics. Analyze or run a script to refresh this list.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DiagnosticsEmptyTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Diagnostics.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding Diagnostics}" Style="{StaticResource DiagnosticGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="65" />
                                <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="70" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Errors" Style="{StaticResource DiagnosticsHeaderTextStyle}" />
                            <Border Style="{StaticResource DiagnosticsCountBadgeStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ErrorCount}" FontSize="11" Foreground="#FF64748B" />
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="#FFF14C4C"
                                             Margin="5,0,0,0"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock Text="No errors.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DiagnosticsEmptyTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorDiagnostics.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding ErrorDiagnostics}" Style="{StaticResource DiagnosticGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="65" />
                                <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="70" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Warnings" Style="{StaticResource DiagnosticsHeaderTextStyle}" />
                            <Border Style="{StaticResource DiagnosticsCountBadgeStyle}">
                                <TextBlock Text="{Binding WarningCount}" FontSize="11" Foreground="#FF64748B" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock Text="No warnings.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DiagnosticsEmptyTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WarningDiagnostics.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding WarningDiagnostics}" Style="{StaticResource DiagnosticGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="65" />
                                <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="70" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Messages" Style="{StaticResource DiagnosticsHeaderTextStyle}" />
                            <Border Style="{StaticResource DiagnosticsCountBadgeStyle}">
                                <TextBlock Text="{Binding MessageCount}" FontSize="11" Foreground="#FF64748B" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock Text="No messages.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DiagnosticsEmptyTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageDiagnostics.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding MessageDiagnostics}" Style="{StaticResource DiagnosticGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="65" />
                                <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="70" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="3"
                Grid.ColumnSpan="3"
                Background="#FFF4F7FB"
                BorderBrush="#FFF8FAFC"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="8,2" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="{Binding BuildStatus}"
                        Style="{StaticResource DiagnosticsStatusButtonStyle}"
                        ToolTip="Open diagnostics"
                        Click="OpenDiagnosticsPanelOnClick" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#FF64748B"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="2,0,8,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
