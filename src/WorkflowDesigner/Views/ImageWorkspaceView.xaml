<UserControl x:Class="WorkflowCore.WpfDemo.Views.ImageWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF252525">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Processed image"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       Foreground="#FFF4F8FB"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Descriptor.DisplayName}"
                       VerticalAlignment="Center"
                       Foreground="#FF9CA4AA"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
        <Border Grid.Row="1" Background="#FF111111" BorderBrush="#FF4C4C4C" BorderThickness="1">
            <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                <TextBlock Text="No processed image for this Action yet"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF858585">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2"
                   Margin="4,7,4,0"
                   Text="{Binding PreviewInfo}"
                   Foreground="#FFADB4B9"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
