<Window x:Class="WorkflowCore.WpfDemo.Views.ProtectedWorkflowPresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protected Workflow"
        Width="1180"
        Height="780"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#FF17191B">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF202326" BorderBrush="#FF393D42" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectNameText" Foreground="#FFF0F2F4" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Read-only protected presentation" Foreground="#FFA4ABB3" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="MethodSelector"
                              Width="240"
                              Height="30"
                              DisplayMemberPath="Name"
                              SelectionChanged="OnMethodChanged" />
                    <TextBlock Text="Zoom" Margin="18,0,8,0" Foreground="#FFA4ABB3" VerticalAlignment="Center" />
                    <Slider x:Name="ZoomSlider"
                            Width="120"
                            Minimum="0.5"
                            Maximum="1.5"
                            Value="1"
                            TickFrequency="0.1"
                            ValueChanged="OnZoomChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#FF17191B">
            <Canvas x:Name="DiagramCanvas" Width="1600" Height="1000" Background="#FF17191B" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FF202326" BorderBrush="#FF393D42" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Margin="14,0"
                       VerticalAlignment="Center"
                       Foreground="#FFA4ABB3"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
