<UserControl x:Class="WorkflowCore.WpfDemo.Views.RuntimeDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource AppPageBrush}">
    <Grid>
        <wv2:WebView2 x:Name="DashboardBrowser"
                      Source="{Binding DashboardUri}"
                      NavigationCompleted="DashboardBrowserOnNavigationCompleted" />
        <Button Content="Bindings"
                Command="{Binding ToggleBindingsCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,12,0"
                Padding="12,6"
                Panel.ZIndex="2" />
        <Border Width="360"
                HorizontalAlignment="Right"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1,0,0,0"
                Panel.ZIndex="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBindingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <TextBlock Text="Project bindings" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}" />
                    <Button Content="Close" Command="{Binding ToggleBindingsCommand}"
                            DockPanel.Dock="Right" Padding="9,4" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="Project variables" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <DockPanel>
                        <Button Content="Add" Command="{Binding AddVariableBindingCommand}"
                                DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" />
                        <ComboBox ItemsSource="{Binding ProjectVariables}"
                                  SelectedItem="{Binding SelectedProjectVariable}"
                                  MinHeight="30" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding VariableBindings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveVariableBindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            DockPanel.Dock="Right" Padding="8,3" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding VariableName}" FontSize="11"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Methods" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <DockPanel>
                        <Button Content="Add" Command="{Binding AddMethodBindingCommand}"
                                DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" />
                        <ComboBox ItemsSource="{Binding ProjectMethods}"
                                  SelectedItem="{Binding SelectedMethod}"
                                  DisplayMemberPath="Name" MinHeight="30" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding MethodBindings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveMethodBindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            DockPanel.Dock="Right" Padding="8,3" />
                                    <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
        <Border VerticalAlignment="Bottom" Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" Margin="14,8" Foreground="{DynamicResource AppMutedTextBrush}" />
        </Border>
    </Grid>
</UserControl>
