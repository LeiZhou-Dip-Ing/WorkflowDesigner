<UserControl x:Class="WorkflowCore.WpfDemo.Views.WorkflowPropertyEditorList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WorkflowCore.WpfDemo.Converters"
             xmlns:views="clr-namespace:WorkflowCore.WpfDemo.Views"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <DataTemplate x:Key="TextEditorTemplate">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsReadOnly="{Binding IsReadOnly}"
                     ToolTip="{Binding Description}"
                     Padding="4,1" BorderThickness="0" />
        </DataTemplate>

        <DataTemplate x:Key="BooleanEditorTemplate">
            <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                      ToolTip="{Binding Description}"
                      VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="SelectionEditorTemplate">
            <ComboBox ItemsSource="{Binding EnumValues}"
                      SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                      ToolTip="{Binding Description}" BorderThickness="0" />
        </DataTemplate>

        <DataTemplate x:Key="LookupEditorTemplate">
            <Grid ToolTip="{Binding Description}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource AppDangerBrush}" Margin="0,0,4,0"
                           VerticalAlignment="Center" ToolTip="{Binding ValidationError}"
                           Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Suggestions}"
                          SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                          IsEditable="{Binding AllowCustomValue}"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                          ToolTip="{Binding Placeholder}"
                          Padding="3,0" BorderThickness="0" />
                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        Width="23" Height="22" Margin="2,0,0,0"
                        Command="{Binding Owner.ClearPropertyValueCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        ToolTip="Clear / Unbound"
                        Visibility="{Binding AllowClear, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="EditorHostStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource TextEditorTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBooleanEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource BooleanEditorTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectionEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource SelectionEditorTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLookupEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource LookupEditorTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}"
                  HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid MinHeight="27" Background="{DynamicResource AppDataGridRowBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="95" />
                        <ColumnDefinition Width="3*" MinWidth="125" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="5,2" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border Grid.Column="1" Padding="3,1" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource EditorHostStyle}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
