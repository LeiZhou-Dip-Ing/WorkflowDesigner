<UserControl x:Class="WorkflowCore.WpfDemo.Views.MethodEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:WorkflowCore.WpfDemo.Models"
             xmlns:behaviors="clr-namespace:WorkflowCore.WpfDemo.Behaviors"
             xmlns:converters="clr-namespace:WorkflowCore.WpfDemo.Converters"
             xmlns:canvas="clr-namespace:WorkflowCore.WpfDemo.Controls.WorkflowCanvas"
             xmlns:controls="clr-namespace:WorkflowCore.WpfDemo.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             behaviors:MethodEditorInteractionBehavior.LoadedCommand="{Binding ActivateCommand}">
    <UserControl.Resources>
        <x:Array x:Key="InputVariableDataTypes" Type="{x:Type sys:String}">
            <sys:String>object</sys:String>
            <sys:String>string</sys:String>
            <sys:String>boolean</sys:String>
            <sys:String>integer</sys:String>
            <sys:String>number</sys:String>
            <sys:String>array</sys:String>
            <sys:String>image</sys:String>
            <sys:String>threadTaskId</sys:String>
        </x:Array>

        <Style x:Key="InputVariableComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="#FF333333" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF4A4A4A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF355A28" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputVariableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="#FF3A3A3A" />
            <Setter Property="BorderBrush" Value="#FF676767" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource InputVariableComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="6,1,3,1"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}">
                                                    <Path Data="M2,3 L6,7 L10,3"
                                                          Width="10"
                                                          Height="7"
                                                          Stretch="Fill"
                                                          Stroke="#FFD5D9DC"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="#FF303030"
                                        BorderBrush="#FF707070"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:ActionTemplateLookupConverter x:Key="ActionTemplateLookupConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <DataTemplate x:Key="ActionIconTemplate">
            <Grid Width="20" Height="20">
                <Path x:Name="FallbackIcon"
                      Data="M9,1 L3,10 H7 L5,17 L14,7 H10 Z"
                      Fill="{StaticResource AccentBrush}"
                      Width="11"
                      Height="15"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                <Image x:Name="CachedIcon"
                       Source="{Binding IconImage}"
                       Width="18"
                       Height="18"
                       Stretch="Uniform"
                       Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="CachedIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ToolboxChromeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF2F4F6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF363636" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF454545" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonBackground" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelHeaderButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolboxChromeButtonStyle}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="MethodToolbarSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="5,7" />
            <Setter Property="Background" Value="#FF454545" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MethodToolbarIconStyle" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.45" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Stroke" Value="#FF747A7E" />
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MethodToolbarViewIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M1,9 C3.2,5.2 5.8,3.5 9,3.5 C12.2,3.5 14.8,5.2 17,9 C14.8,12.8 12.2,14.5 9,14.5 C5.8,14.5 3.2,12.8 1,9 Z M6.5,9 A2.5,2.5 0 1 0 11.5,9 A2.5,2.5 0 1 0 6.5,9 Z" />
        </Style>
        <Style x:Key="MethodToolbarOptionsIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M2,4 H6 M10,4 H16 M8,2 V6 M2,9 H10 M14,9 H16 M12,7 V11 M2,14 H4 M8,14 H16 M6,12 V16" />
        </Style>
        <Style x:Key="MethodToolbarSaveIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M2,2 H13 L16,5 V16 H2 Z M5,2 V7 H12 V2 M5,16 V10 H13 V16" />
        </Style>
        <Style x:Key="MethodToolbarUndoIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M7,4 L3,8 L7,12 M3,8 H10 C14,8 16,10 16,14" />
        </Style>
        <Style x:Key="MethodToolbarRunIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M5,3 L15,9 L5,15 Z" />
        </Style>
        <Style x:Key="MethodToolbarDeployIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M5,14 H3.5 C1.8,14 1,12.8 1,11.3 C1,9.7 2.2,8.5 3.8,8.5 C4.2,5.8 6.2,4 9,4 C11.5,4 13.4,5.4 14,7.7 C15.8,7.8 17,9 17,10.8 C17,12.6 15.8,14 14,14 H12 M9,14 V6 M6,9 L9,6 L12,9" />
        </Style>
        <Style x:Key="MethodToolbarDownloadIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M5,14 H3.5 C1.8,14 1,12.8 1,11.3 C1,9.7 2.2,8.5 3.8,8.5 C4.2,5.8 6.2,4 9,4 C11.5,4 13.4,5.4 14,7.7 C15.8,7.8 17,9 17,10.8 C17,12.6 15.8,14 14,14 H12 M9,6 V14 M6,11 L9,14 L12,11" />
        </Style>
        <Style x:Key="MethodToolbarCompareIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M3,6 H14 M11,3 L14,6 L11,9 M15,12 H4 M7,9 L4,12 L7,15" />
        </Style>
        <Style x:Key="MethodToolbarExportIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M9,3 H16 V10 M16,3 L8,11 M13,15 H3 V5 H8" />
        </Style>
        <Style x:Key="MethodToolbarParametersIconStyle" TargetType="Path" BasedOn="{StaticResource MethodToolbarIconStyle}">
            <Setter Property="Data" Value="M1,4 H3 M6,4 H17 M1,9 H3 M6,9 H17 M1,14 H3 M6,14 H17" />
        </Style>

        <Style x:Key="ToolboxTreeItemStyle"
               TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Foreground" Value="#FFF4F7F9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ToolboxPopupActionRowStyle" TargetType="Border">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF363636" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MethodContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinWidth" Value="310" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ItemBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1">
                                <Grid Height="{TemplateBinding Height}"
                                      MinWidth="{TemplateBinding MinWidth}"
                                      Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{TemplateBinding InputGestureText}"
                                               Foreground="#FFB8BEC4"
                                               VerticalAlignment="Center"
                                               Margin="28,0,8,0" />
                                    <Path x:Name="SubmenuArrow"
                                          Grid.Column="2"
                                          Data="M1,1 L7,6 L1,11 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          Width="6"
                                          Height="10"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-2"
                                   VerticalOffset="-3"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#FF252525"
                                        BorderBrush="#FF646464"
                                        BorderThickness="1"
                                        Padding="3">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#FF3C3C3C" />
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="#FF555B60" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#FF3C3C3C" />
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="#FF696969" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF73787D" />
                                <Setter TargetName="ItemBackground" Property="Background" Value="Transparent" />
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MethodContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="10,4"
                                Background="#FF5A5A5A" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MethodContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#FF252525" />
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="BorderBrush" Value="#FF646464" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Focusable="False">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PropertyTextEditorTemplate">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     ToolTip="{Binding Description}"
                     Padding="4,2"
                     BorderThickness="0">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="#FFE8893A" />
                                <Setter Property="ToolTip" Value="{Binding ValidationError}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <Style x:Key="PropertyCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="#FF343434" />
            <Setter Property="BorderBrush" Value="#FF777777" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Path x:Name="CheckMark"
                                      Data="M2,7 L5.5,10.5 L13,2.5"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="#FF2E3B27" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFA6A6A6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PropertyComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="#FF333333" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF4A4A4A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF355A28" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PropertyComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFF3F5F7" />
            <Setter Property="Background" Value="#FF3A3A3A" />
            <Setter Property="BorderBrush" Value="#FF676767" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="23" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PropertyComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="6,1,3,1"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="4,0,2,0"
                                             Padding="2,1"
                                             Foreground="{TemplateBinding Foreground}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed" />
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}">
                                                    <Path Data="M2,3 L6,7 L10,3"
                                                          Width="10"
                                                          Height="7"
                                                          Stretch="Fill"
                                                          Stroke="#FFD5D9DC"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="#FF303030"
                                        BorderBrush="#FF707070"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PropertyBooleanEditorTemplate">
            <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource PropertyCheckBoxStyle}"
                      ClickMode="Press"
                      Focusable="False"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="1,0,0,0"
                      ToolTip="{Binding Description}">
                <CheckBox.IsEnabled>
                    <Binding Path="IsReadOnly" Converter="{StaticResource InverseBooleanConverter}" />
                </CheckBox.IsEnabled>
            </CheckBox>
        </DataTemplate>

        <DataTemplate x:Key="PropertySelectionEditorTemplate">
            <ComboBox ItemsSource="{Binding EnumValues}"
                      SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                      Style="{StaticResource PropertyComboBoxStyle}"
                      ToolTip="{Binding Description}"
                      Padding="3,1">
                <ComboBox.IsEnabled>
                    <Binding Path="IsReadOnly" Converter="{StaticResource InverseBooleanConverter}" />
                </ComboBox.IsEnabled>
            </ComboBox>
        </DataTemplate>

        <DataTemplate x:Key="PropertyJsonEditorTemplate">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     FontFamily="Consolas"
                     ToolTip="{Binding Description}"
                     Padding="4,2"
                     BorderThickness="0">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="#FFE8893A" />
                                <Setter Property="ToolTip" Value="{Binding ValidationError}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <Style x:Key="PropertyEditorIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolboxChromeButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="23" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFF2F4F6" />
        </Style>

        <DataTemplate x:Key="PropertyLookupEditorTemplate">
            <Grid ToolTip="{Binding Description}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE711;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="#FFE55353"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"
                           ToolTip="{Binding ValidationError}"
                           Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Suggestions}"
                          SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Text="{Binding ValueText, Mode=OneWay}"
                          IsEditable="{Binding AllowCustomValue}"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          Padding="3,0"
                          Style="{StaticResource PropertyComboBoxStyle}"
                          BorderThickness="0"
                          ToolTip="{Binding Placeholder}"
                          LostKeyboardFocus="PropertyLookupLostKeyboardFocus"
                          KeyDown="PropertyLookupKeyDown">
                    <ComboBox.IsEnabled>
                        <Binding Path="IsReadOnly" Converter="{StaticResource InverseBooleanConverter}" />
                    </ComboBox.IsEnabled>
                </ComboBox>

                <Button Grid.Column="2"
                        Content="&#xE710;"
                        Style="{StaticResource PropertyEditorIconButtonStyle}"
                        Command="{Binding DataContext.Owner.CreatePropertyValueCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        ToolTip="Create variable"
                        Visibility="{Binding AllowCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Grid.Column="3"
                        Content="&#xE711;"
                        Style="{StaticResource PropertyEditorIconButtonStyle}"
                        Command="{Binding DataContext.Owner.ClearPropertyValueCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        ToolTip="Clear value"
                        Visibility="{Binding AllowClear, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PropertyStrictLookupEditorTemplate">
            <Grid ToolTip="{Binding Description}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE711;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="#FFE55353"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"
                           ToolTip="{Binding ValidationError}"
                           Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Suggestions}"
                          SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Text="{Binding ValueText, Mode=OneWay}"
                          IsEditable="False"
                          IsTextSearchEnabled="True"
                          Padding="3,0"
                          Style="{StaticResource PropertyComboBoxStyle}"
                          BorderThickness="0"
                          ToolTip="{Binding Placeholder}">
                    <ComboBox.IsEnabled>
                        <Binding Path="IsReadOnly" Converter="{StaticResource InverseBooleanConverter}" />
                    </ComboBox.IsEnabled>
                </ComboBox>

                <Button Grid.Column="2"
                        Content="&#xE710;"
                        Style="{StaticResource PropertyEditorIconButtonStyle}"
                        Command="{Binding DataContext.Owner.CreatePropertyValueCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        ToolTip="Create variable"
                        Visibility="{Binding AllowCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Grid.Column="3"
                        Content="&#xE711;"
                        Style="{StaticResource PropertyEditorIconButtonStyle}"
                        Command="{Binding DataContext.Owner.ClearPropertyValueCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        ToolTip="Clear value"
                        Visibility="{Binding AllowClear, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PropertyEditorHostStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource PropertyTextEditorTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBooleanEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource PropertyBooleanEditorTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectionEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource PropertySelectionEditorTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsJsonEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource PropertyJsonEditorTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLookupEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource PropertyLookupEditorTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStrictLookupEditor}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource PropertyStrictLookupEditorTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PropertyGroupExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="#FFF4F8FB" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="#FF525252"
                                          BorderBrush="#FF686868"
                                          BorderThickness="0,1,0,1"
                                          Foreground="#FFF4F8FB"
                                          Focusable="False"
                                          HorizontalAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Width="7"
                                                      Height="7"
                                                      Fill="#FFE1E4E6"
                                                      Stretch="Uniform"
                                                      Data="M1,1 L7,5 L1,9 Z"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  Margin="0,0,4,0"
                                                                  VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M1,2 L9,2 L5,8 Z" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF5B5B5B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              ContentSource="Content"
                                              HorizontalAlignment="Stretch"
                                              Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Z"
                    Modifiers="Control"
                    Command="{Binding Owner.UndoCommand}"
                    CommandParameter="{Binding}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF252525"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Right"
                        CornerRadius="3"
                        Margin="8,5,10,5"
                        Padding="10,3"
                        ToolTip="{Binding Owner.StatusText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF8A4B12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Owner.IsRuntimeOnline}" Value="True">
                                    <Setter Property="Background" Value="#FF237A3B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Owner.RuntimeConnectionText}"
                               Foreground="#FFFFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>

                <Border DockPanel.Dock="Right"
                        CornerRadius="3"
                        Margin="8,5,0,5"
                        Padding="10,3"
                        ToolTip="Local saved Project compared with the active Runtime revision">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF555555" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Owner.IsDeploymentSynchronized}" Value="True">
                                    <Setter Property="Background" Value="#FF237A3B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Owner.HasUndeployedSavedChanges}" Value="True">
                                    <Setter Property="Background" Value="#FF9A5A13" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Owner.HasUnsavedLocalChanges}" Value="True">
                                    <Setter Property="Background" Value="#FF255F8F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Owner.DeploymentStatusText}"
                               Foreground="#FFFFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>

                <Menu Padding="4,0" FontSize="12">
                    <MenuItem Header="View" Padding="6,2">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarViewIconStyle}" />
                        </MenuItem.Icon>
                        <MenuItem Header="Expand explorer" Command="{Binding Owner.ExpandExplorerCommand}" />
                        <MenuItem Header="Collapse explorer" Command="{Binding Owner.CollapseExplorerCommand}" />
                        <Separator />
                        <MenuItem Header="Clear log" Command="{Binding Owner.ClearLogCommand}" />
                    </MenuItem>
                    <MenuItem Header="Options" Padding="6,2">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarOptionsIconStyle}" />
                        </MenuItem.Icon>
                        <MenuItem Header="Import method / script..." Command="{Binding Owner.ImportJsonCommand}" />
                        <Separator />
                        <MenuItem Header="Export entire project..." Command="{Binding Owner.ExportProjectJsonCommand}" />
                        <Separator />
                        <MenuItem Header="Method type">
                            <MenuItem Header="Normal" Command="{Binding Owner.SetMethodTypeCommand}" CommandParameter="Normal" />
                            <MenuItem Header="Initialization" Command="{Binding Owner.SetMethodTypeCommand}" CommandParameter="Initialization" />
                            <MenuItem Header="System" Command="{Binding Owner.SetMethodTypeCommand}" CommandParameter="System" />
                        </MenuItem>
                        <MenuItem Header="Init at start" IsCheckable="True" IsChecked="{Binding Method.InitAtStart, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="New method" Command="{Binding Owner.NewMethodCommand}" />
                        <MenuItem Header="Open method" Command="{Binding Owner.OpenSelectedMethodCommand}" />
                        <MenuItem Header="Delete method" Command="{Binding Owner.DeleteMethodCommand}" />
                    </MenuItem>
                    <Separator Style="{StaticResource MethodToolbarSeparatorStyle}" />
                    <MenuItem Header="Save method"
                              Padding="6,2"
                              Command="{Binding Owner.SaveWorkflowCommand}"
                              ToolTip="Save the current method locally only">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarSaveIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Undo"
                              Padding="6,2"
                              Command="{Binding Owner.UndoCommand}"
                              CommandParameter="{Binding}"
                              InputGestureText="Ctrl+Z">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarUndoIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Run" Padding="6,2" Command="{Binding Owner.RunCommand}" ToolTip="Test the current editor method on Runtime without deploying">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarRunIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="&#xE70D;"
                              FontFamily="Segoe MDL2 Assets"
                              Padding="3,2"
                              ToolTip="Choose run mode">
                        <MenuItem Header="Run"
                                  FontFamily="Segoe UI"
                                  Command="{Binding Owner.RunCommand}"
                                  InputGestureText="F5" />
                        <MenuItem Header="Step Run"
                                  FontFamily="Segoe UI"
                                  Command="{Binding Owner.StepRunCommand}"
                                  InputGestureText="F10" />
                    </MenuItem>
                    <MenuItem Header="Step"
                              Padding="6,2"
                              Command="{Binding Owner.StepCommand}"
                              Visibility="{Binding Owner.IsStepRun, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ToolTip="Execute the next action and pause on its completed image">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Continue"
                              Padding="6,2"
                              Command="{Binding Owner.ContinueCommand}"
                              Visibility="{Binding Owner.IsStepRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Pause"
                              Padding="6,2"
                              Command="{Binding Owner.PauseCommand}"
                              Visibility="{Binding Owner.IsStepRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" Foreground="#FFD8DDE1" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Stop"
                              Padding="6,2"
                              Command="{Binding Owner.CancelCommand}"
                              Visibility="{Binding Owner.IsStepRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Foreground="#FFD8DDE1" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource MethodToolbarSeparatorStyle}" />
                    <MenuItem Header="Deploy method"
                              Padding="6,2"
                              Command="{Binding Owner.DeploySelectedDocumentCommand}"
                              CommandParameter="{Binding}"
                              ToolTip="Replace or add only this saved method in Workflow Runtime by UID">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarDeployIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Download"
                              Padding="6,2"
                              Command="{Binding Owner.DownloadWorkflowCommand}"
                              ToolTip="Replace the local Project with the active Runtime Project">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarDownloadIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Compare"
                              Padding="6,2"
                              Command="{Binding Owner.CompareWorkflowCommand}"
                              ToolTip="Compare the complete local Project with the active Runtime revision">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarCompareIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource MethodToolbarSeparatorStyle}" />
                    <MenuItem Header="Export"
                              Padding="6,2"
                              Command="{Binding Owner.ExportJsonCommand}"
                              ToolTip="Export the selected AvalonDock document">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarExportIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Configure method inputs / outputs"
                              Padding="6,2"
                              Command="{Binding Owner.ConfigureMethodVariablesCommand}"
                              ToolTip="Define the values this method intentionally exposes to callers">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MethodToolbarParametersIconStyle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <Border Background="#FF40391F"
                    BorderBrush="#FFC9A52B"
                    BorderThickness="0,0,0,1"
                    Padding="10,7"
                    Visibility="{Binding Owner.HasSelectedMethodDeploymentWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding Owner.DeploySelectedDocumentCommand}"
                            CommandParameter="{Binding}"
                            Content="Deploy method"
                            MinWidth="104"
                            Padding="10,3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Save first if this method still has local changes" />
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#FFFFD45B"
                               Margin="0,0,9,0"
                               VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Owner.SelectedMethodDeploymentWarningText}"
                               Foreground="#FFFFF0BD"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Background="#FF5C3018"
                    BorderBrush="#FFE8893A"
                    BorderThickness="0,0,0,1"
                    Padding="10,7"
                    Visibility="{Binding Owner.HasWorkflowIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#FFFFC27A"
                               Margin="0,0,9,0"
                               VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Owner.WorkflowIssuesMessage}"
                               Foreground="#FFFFE6CF"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="8" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="42" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActionsToolboxExpanded}" Value="True">
                                <Setter Property="Width" Value="248" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="430" MinWidth="320" MaxWidth="520" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,8,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#FF575757"
                BorderThickness="1"
                Visibility="{Binding IsActionsToolboxExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="#FF4A4A4A" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Canvas Width="22"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Line X1="7" Y1="5" X2="16" Y2="10"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Line X1="7" Y1="15" X2="16" Y2="10"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="2" Canvas.Top="1" Width="7" Height="7"
                                     Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="2" Canvas.Top="12" Width="7" Height="7"
                                     Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="14" Canvas.Top="6.5" Width="7" Height="7"
                                     Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                        </Canvas>
                        <TextBlock Grid.Column="1"
                                   Text="Actions"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF2F4F6" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ToolboxChromeButtonStyle}"
                                Command="{Binding ToggleActionsToolboxCommand}"
                                AutomationProperties.Name="Collapse Actions"
                                ToolTip="Collapse Actions">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <TreeView x:Name="ActionToolboxTree"
                              ItemsSource="{Binding Owner.ActionToolbox}"
                              Background="{StaticResource PanelBrush}"
                              Foreground="#FFF4F7F9"
                              BorderThickness="0"
                              Padding="5,6,7,8"
                              ItemContainerStyle="{StaticResource ToolboxTreeItemStyle}"
                              behaviors:ActionToolboxDragBehavior.IsEnabled="True"
                              behaviors:ActionToolboxDragBehavior.ItemDoubleClickCommand="{Binding AddActionFromExpandedToolboxCommand}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:ActionTemplateItem}"
                                                      ItemsSource="{Binding Children}">
                                <Grid Height="27"
                                      MinWidth="150"
                                      Margin="1,0"
                                      ToolTip="{Binding Description}"
                                      ToolTipService.ShowDuration="20000">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid x:Name="ActionIconHost"
                                          Width="22"
                                          Height="22"
                                          Margin="0,0,3,0">
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource ActionIconTemplate}" />
                                    </Grid>

                                    <TextBlock x:Name="ActionName"
                                               Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               Foreground="#FFF2F4F6"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                        <Setter TargetName="ActionIconHost" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ActionName" Property="FontSize" Value="12.5" />
                                        <Setter TargetName="ActionName" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="ActionName" Property="Foreground" Value="#FFDDE2E6" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <TextBlock Text="No actions available"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Owner.ActionToolbox.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="CollapsedActionsRail"
                Grid.Column="0"
                Width="42"
                Margin="0,0,8,0"
                HorizontalAlignment="Left"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#FF575757"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActionsToolboxExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Style="{StaticResource ToolboxChromeButtonStyle}"
                        Command="{Binding ToggleActionsToolboxCommand}"
                        AutomationProperties.Name="Expand Actions"
                        ToolTip="Expand Actions">
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12" />
                </Button>

                <Button Grid.Row="1"
                        Style="{StaticResource ToolboxChromeButtonStyle}"
                        Command="{Binding OpenActionsToolboxPopupCommand}"
                        AutomationProperties.Name="Open Actions"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Top"
                        ToolTip="Actions">
                    <StackPanel Margin="0,15,0,0">
                        <Canvas Width="22"
                                Height="20"
                                HorizontalAlignment="Center">
                            <Line X1="7" Y1="5" X2="16" Y2="10"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Line X1="7" Y1="15" X2="16" Y2="10"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="2" Canvas.Top="1" Width="7" Height="7"
                                     Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="2" Canvas.Top="12" Width="7" Height="7"
                                     Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="14" Canvas.Top="6.5" Width="7" Height="7"
                                     Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                        </Canvas>
                        <TextBlock Text="Actions"
                                   FontSize="12"
                                   Foreground="#FFF2F4F6"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Popup PlacementTarget="{Binding ElementName=CollapsedActionsRail}"
               Placement="Right"
               HorizontalOffset="-8"
               VerticalOffset="0"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False"
               IsOpen="{Binding IsActionsToolboxPopupOpen, Mode=TwoWay}">
            <Border Width="248"
                    Height="{Binding ActualHeight, ElementName=CollapsedActionsRail}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#FF676767"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      Direction="0"
                                      ShadowDepth="4"
                                      Opacity="0.5"
                                      Color="#FF000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#FF4A4A4A" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="22"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Line X1="7" Y1="5" X2="16" Y2="10"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                <Line X1="7" Y1="15" X2="16" Y2="10"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="2" Canvas.Top="1" Width="7" Height="7"
                                         Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="2" Canvas.Top="12" Width="7" Height="7"
                                         Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="14" Canvas.Top="6.5" Width="7" Height="7"
                                         Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            </Canvas>
                            <TextBlock Grid.Column="1"
                                       Text="Actions"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF2F4F6" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource ToolboxChromeButtonStyle}"
                                    Command="{Binding ToggleActionsToolboxCommand}"
                                    AutomationProperties.Name="Keep Actions open"
                                    ToolTip="Keep Actions open">
                                <TextBlock Text="&#xE718;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <TreeView ItemsSource="{Binding Owner.ActionToolbox}"
                                  Background="{StaticResource PanelBrush}"
                                  Foreground="#FFF4F7F9"
                                  BorderThickness="0"
                                  Padding="5,6,7,8"
                                  ItemContainerStyle="{StaticResource ToolboxTreeItemStyle}"
                                  behaviors:ActionToolboxDragBehavior.IsEnabled="True"
                                  behaviors:ActionToolboxDragBehavior.DragCompletedCommand="{Binding KeepActionsToolboxPopupOpenCommand}"
                                  behaviors:ActionToolboxDragBehavior.ItemClickCommand="{Binding AddActionFromToolboxPopupCommand}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type models:ActionTemplateItem}"
                                                          ItemsSource="{Binding Children}">
                                    <Grid Height="29"
                                          MinWidth="150"
                                          Margin="1,0"
                                          ToolTip="{Binding Description}"
                                          ToolTipService.ShowDuration="20000">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid x:Name="PopupActionIconHost"
                                              Width="22"
                                              Height="22"
                                              Margin="0,0,3,0">
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource ActionIconTemplate}" />
                                        </Grid>

                                        <Border x:Name="PopupActionRow"
                                                Grid.Column="1"
                                                Style="{StaticResource ToolboxPopupActionRowStyle}"
                                                AutomationProperties.Name="{Binding DisplayName}">
                                            <TextBlock x:Name="PopupActionName"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="#FFF2F4F6"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                            <Setter TargetName="PopupActionIconHost" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="PopupActionRow" Property="Cursor" Value="Arrow" />
                                            <Setter TargetName="PopupActionName" Property="FontSize" Value="12.5" />
                                            <Setter TargetName="PopupActionName" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="PopupActionName" Property="Foreground" Value="#FFDDE2E6" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <TextBlock Text="No actions available"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Owner.ActionToolbox.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Grid x:Name="MethodWorkspace"
              Grid.Column="1"
              Margin="0"
              MinWidth="0"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="170" MinHeight="90" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Method name"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox Grid.Column="1"
                             MinWidth="180"
                             Text="{Binding Method.Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Method name" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#FF282828"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,0,1,1">
                <TextBox Margin="10,6"
                         Padding="8,3"
                         Text="Search in method lines (Ctrl+F)"
                         Foreground="{StaticResource MutedTextBrush}"
                         IsReadOnly="True" />
            </Border>

            <TabControl Grid.Row="2"
                        Background="#FF17191B"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Foreground" Value="#FFAAB2BA" />
                        <Setter Property="Background" Value="#FF232629" />
                        <Setter Property="BorderBrush" Value="#FF3B4045" />
                        <Setter Property="Padding" Value="18,8" />
                        <Setter Property="Margin" Value="0,0,1,0" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Grid SnapsToDevicePixels="True">
                                        <Border x:Name="HeaderBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="0,0,1,1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="SelectionLine"
                                                Height="2"
                                                Background="#FF2D9CDB"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#FF2B2F33" />
                                            <Setter Property="Foreground" Value="#FFF2F5F7" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#FF17191B" />
                                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#FF4A5056" />
                                            <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="List view">
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

            <DataGrid x:Name="MethodLinesGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding Owner.VisibleMethodLineItems}"
                      SelectedItem="{Binding Owner.SelectedMethodLineItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      AllowDrop="True"
                      SelectionMode="Single"
                      AlternationCount="2"
                      RowHeight="27"
                      BorderThickness="1,0,1,1"
                      MaxWidth="{Binding ActualWidth, ElementName=MethodWorkspace}"
                      behaviors:MethodEditorInteractionBehavior.DropActionCommand="{Binding DropActionCommand}"
                      behaviors:MethodEditorInteractionBehavior.ItemDoubleClickCommand="{Binding OpenSelectedActionEditorCommand}"
                      behaviors:MethodEditorInteractionBehavior.SelectRowOnRightClick="True">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Insert" Command="{Binding OpenActionInsertionPopupCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding Owner.DeleteLineCommand}" />
                    <KeyBinding Key="F5" Modifiers="Control" Command="{Binding Owner.AddIfBlockCommand}" CommandParameter="False" />
                    <KeyBinding Key="F5" Modifiers="Control+Shift" Command="{Binding Owner.AddIfBlockCommand}" CommandParameter="True" />
                    <KeyBinding Key="F5" Modifiers="Control+Alt" Command="{Binding Owner.AddElseBranchCommand}" />
                    <KeyBinding Key="F6" Modifiers="Control" Command="{Binding Owner.AddForBlockCommand}" CommandParameter="False" />
                    <KeyBinding Key="F6" Modifiers="Control+Shift" Command="{Binding Owner.AddForBlockCommand}" CommandParameter="True" />
                    <KeyBinding Key="F7" Modifiers="Control" Command="{Binding Owner.AddWhileBlockCommand}" CommandParameter="False" />
                    <KeyBinding Key="F7" Modifiers="Control+Shift" Command="{Binding Owner.AddWhileBlockCommand}" CommandParameter="True" />
                    <KeyBinding Key="C" Modifiers="Control" Command="{Binding Owner.CopyLineCommand}" />
                    <KeyBinding Key="X" Modifiers="Control" Command="{Binding Owner.CutLineCommand}" />
                    <KeyBinding Key="V" Modifiers="Control" Command="{Binding Owner.PasteLineCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource MethodContextMenuStyle}">
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource MethodContextMenuItemStyle}" />
                            <Style TargetType="Separator" BasedOn="{StaticResource MethodContextMenuSeparatorStyle}" />
                        </ContextMenu.Resources>
                        <MenuItem Header="Add action..."
                                  InputGestureText="Ins"
                                  Command="{Binding OpenActionInsertionPopupCommand}" />
                        <MenuItem Header="Delete action"
                                  InputGestureText="Del"
                                  Command="{Binding Owner.DeleteLineCommand}" />
                        <Separator />
                        <MenuItem Header="Activate action"
                                  Command="{Binding Owner.ActivateLineCommand}" />
                        <MenuItem Header="Deactivate action"
                                  Command="{Binding Owner.DeactivateLineCommand}" />
                        <Separator />
                        <MenuItem Header="Add condition">
                            <MenuItem Header="Add after current"
                                      InputGestureText="Ctrl+F5"
                                      Command="{Binding Owner.AddIfBlockCommand}"
                                      CommandParameter="False" />
                            <MenuItem Header="Surround current action"
                                      InputGestureText="Ctrl+Shift+F5"
                                      Command="{Binding Owner.AddIfBlockCommand}"
                                      CommandParameter="True" />
                            <MenuItem Header="Add ELSE branch"
                                      InputGestureText="Ctrl+Alt+F5"
                                      Command="{Binding Owner.AddElseBranchCommand}" />
                        </MenuItem>
                        <MenuItem Header="Add FOR-loop">
                            <MenuItem Header="Add after current"
                                      InputGestureText="Ctrl+F6"
                                      Command="{Binding Owner.AddForBlockCommand}"
                                      CommandParameter="False" />
                            <MenuItem Header="Surround current action"
                                      InputGestureText="Ctrl+Shift+F6"
                                      Command="{Binding Owner.AddForBlockCommand}"
                                      CommandParameter="True" />
                        </MenuItem>
                        <MenuItem Header="Add WHILE-loop">
                            <MenuItem Header="Add after current"
                                      InputGestureText="Ctrl+F7"
                                      Command="{Binding Owner.AddWhileBlockCommand}"
                                      CommandParameter="False" />
                            <MenuItem Header="Surround current action"
                                      InputGestureText="Ctrl+Shift+F7"
                                      Command="{Binding Owner.AddWhileBlockCommand}"
                                      CommandParameter="True" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Cut"
                                  InputGestureText="Ctrl+X"
                                  Command="{Binding Owner.CutLineCommand}" />
                        <MenuItem Header="Copy"
                                  InputGestureText="Ctrl+C"
                                  Command="{Binding Owner.CopyLineCommand}" />
                        <MenuItem Header="Paste after current"
                                  InputGestureText="Ctrl+V"
                                  Command="{Binding Owner.PasteLineCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeactivated}" Value="True">
                                <Setter Property="Opacity" Value="0.52" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Line.IsActionAvailable}" Value="False">
                                <Setter Property="Background" Value="#FF5A2A20" />
                                <Setter Property="Foreground" Value="#FFFFE2D5" />
                                <Setter Property="ToolTip" Value="{Binding Line.ActionAvailabilityMessage}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Action" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="20"
                                            Visibility="{Binding DataContext.Owner.IsStepRun, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Path Grid.Column="0"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Fill="#FFFFFF00"
                                          Stroke="#FF5A5A00"
                                          StrokeThickness="0.7"
                                          Data="M0,5 L9,5 L9,1 L16,8 L9,15 L9,11 L0,11 Z"
                                          Visibility="{Binding IsDebugCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border Grid.Column="1" Width="{Binding IndentWidth}" />

                                    <Button Grid.Column="2"
                                            Command="{Binding ToggleExpansionCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0"
                                            MinHeight="0"
                                            Width="18"
                                            Height="22"
                                            ToolTip="Expand or collapse child actions">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolboxChromeButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Width="8"
                                              Height="8"
                                              Stretch="Uniform"
                                              Fill="#FFD8DDE1">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="M2,1 L8,6 L2,11 Z" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Data" Value="M1,2 L11,2 L6,8 Z" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>

                                    <ContentControl Grid.Column="3"
                                                    Width="22"
                                                    Height="20"
                                                    Margin="0,0,2,0"
                                                    Content="{Binding ActionTemplate}"
                                                    ContentTemplate="{StaticResource ActionIconTemplate}" />

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding DisplayName}"
                                               Foreground="#FF42A5F5"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock DockPanel.Dock="Right"
                                               Grid.Column="5"
                                               Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFB36B"
                                               Margin="8,0,0,0"
                                               ToolTip="{Binding Line.ActionAvailabilityMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Line.IsActionAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
                    <DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" Width="52" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Background="#FF252525"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,0,1,1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Records"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Owner.RecordStatus}"
                               Foreground="#FFF4F8FB"
                               FontSize="11"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>
            </Grid>

                </TabItem>
                <TabItem Header="Canvas view">
                    <canvas:WorkflowCanvasControl />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="3"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="#FF3F3F3F"
                          ShowsPreview="True" />

            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Action run log"
                                   FontWeight="SemiBold"
                                   Margin="10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Owner.RuntimeEvents.Count, StringFormat={}{0} records}"
                                   Margin="12,0,10,0"
                                   Foreground="#FFB7C0C8"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Owner.RuntimeEvents}"
                             Background="{StaticResource SurfaceBrush}"
                             BorderBrush="Transparent"
                             Foreground="#FFF4F8FB"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Grid.Column="0"
                                                        Width="22"
                                                        Height="20"
                                                        Content="{Binding ActionTemplate}"
                                                        ContentTemplate="{StaticResource ActionIconTemplate}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ActionName}"
                                                   Foreground="#FF42A5F5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Status}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFFFB65C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF65D67A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFF6B6B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Result}"
                                                   Foreground="#FFF4F8FB"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="8,0" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Location}"
                                                   Foreground="#FFB7BEC5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding Time}"
                                                   ToolTip="Action start time (local)"
                                                   FontFamily="Consolas"
                                                   Foreground="#FF929AA2"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="2"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="#FF3F3F3F"
                      ShowsPreview="True" />

        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="44*" />
                <RowDefinition Height="56*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    Visibility="{Binding Owner.IsSelectedPropertyWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#FF252525" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="{Binding Owner.SelectedActionTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   ToolTip="{Binding Owner.SelectedActionDescription}" />
                    </Border>
                    <ItemsControl x:Name="SelectedActionPropertiesList"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Owner.SelectedActionPropertiesView}"
                                  Background="#FF444444"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <Border Background="{TemplateBinding Background}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True"
                                                  Focusable="False">
                                        <ItemsPresenter HorizontalAlignment="Stretch" />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True"
                                                              HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch"
                                                              Header="{Binding Name}"
                                                              Style="{StaticResource PropertyGroupExpanderStyle}">
                                                        <ItemsPresenter HorizontalAlignment="Stretch" />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="25"
                                      HorizontalAlignment="Stretch"
                                      Background="#FF444444">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="150" />
                                        <ColumnDefinition Width="3*" MinWidth="180" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Padding="6,1"
                                            BorderBrush="#FF676767"
                                            BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   ToolTip="{Binding Description}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            Padding="6,1"
                                            BorderBrush="#FF676767"
                                            BorderThickness="0,0,0,1">
                                        <ContentControl Content="{Binding}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Style="{StaticResource PropertyEditorHostStyle}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FF252525">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Method variables"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0" />
                        <Button Grid.Column="1"
                                Command="{Binding Owner.RefreshVariablesCommand}"
                                Style="{StaticResource PanelHeaderButtonStyle}"
                                Margin="2,2,0,2"
                                MinHeight="0"
                                ToolTip="Rescan Action references and synchronize method variable declarations">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding Owner.RenameVariableCommand}"
                                Style="{StaticResource PanelHeaderButtonStyle}"
                                Margin="0,2,6,2"
                                MinHeight="0"
                                ToolTip="Rename the selected variable and update its Action references">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Rename" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Owner.SelectedMethodVariables}"
                              SelectedItem="{Binding Owner.SelectedMethodVariable}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              RowHeight="26"
                              Background="#FF353535"
                              RowBackground="#FF414141"
                              AlternatingRowBackground="#FF3B3B3B"
                              GridLinesVisibility="All"
                              BorderThickness="0">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="BorderBrush" Value="#FF626262" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Variable name"
                                                Binding="{Binding VariableName}"
                                                IsReadOnly="True"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <controls:DesignerWorkspaceHost Grid.Row="0"
                                            Grid.RowSpan="2"
                                            WorkspaceKey="{Binding Owner.SelectedActionWorkspaceKey}"
                                            FallbackWorkspaceKey="{Binding Owner.SelectedActionWorkspaceFallbackKey}"
                                            ActionContext="{Binding Owner.SelectedDesignerActionContext}"
                                            Visibility="{Binding Owner.IsSelectedCustomWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
        </Grid>

        <Grid Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="{StaticResource SurfaceBrush}"
              Visibility="{Binding Owner.IsMethodVariablesDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#FF252525" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                <DockPanel Margin="10,0">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding Owner.CloseMethodVariablesCommand}"
                            Style="{StaticResource PanelHeaderButtonStyle}"
                            Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Close" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Method inputs / outputs"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="8,8,8,4" Padding="10,7"
                    Background="#FF303030" BorderBrush="#FF555555" BorderThickness="1">
                <TextBlock Text="Only parameters declared here are visible to Run Method, REST callers, DLL Actions, and future C# Scripts. Internal variables remain private."
                           Foreground="#FFD0D0D0" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Border>

            <Grid Grid.Row="2" Margin="8,4,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#FF353535" BorderBrush="#FF5D5D5D" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Background="#FF2A2A2A" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,4,5,4">
                                <Button Content="Add input" Command="{Binding Owner.AddMethodInputCommand}"
                                        Style="{StaticResource PanelHeaderButtonStyle}" Padding="8,3" Margin="0,0,4,0" />
                                <Button Content="Delete" Command="{Binding Owner.DeleteMethodInputCommand}"
                                        Style="{StaticResource PanelHeaderButtonStyle}" Padding="8,3" />
                            </StackPanel>
                            <TextBlock Text="Inputs" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Owner.SelectedMethodInputs}"
                                  SelectedItem="{Binding Owner.SelectedMethodInput}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" RowHeight="28"
                                  Background="#FF353535" RowBackground="#FF414141"
                                  AlternatingRowBackground="#FF3B3B3B" GridLinesVisibility="All" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="0.9*" />
                                <DataGridTextColumn Header="Method variable" Binding="{Binding VariableName}" IsReadOnly="True" Width="1.15*" />
                                <DataGridComboBoxColumn Header="Type" ItemsSource="{StaticResource InputVariableDataTypes}"
                                                        SelectedItemBinding="{Binding ValueType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" />
                                <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required, Mode=TwoWay}" Width="72" />
                                <DataGridTextColumn Header="Default" Binding="{Binding DefaultValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#FF353535" BorderBrush="#FF5D5D5D" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Background="#FF2A2A2A" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,4,5,4">
                                <Button Content="Add output" Command="{Binding Owner.AddMethodOutputCommand}"
                                        Style="{StaticResource PanelHeaderButtonStyle}" Padding="8,3" Margin="0,0,4,0" />
                                <Button Content="Delete" Command="{Binding Owner.DeleteMethodOutputCommand}"
                                        Style="{StaticResource PanelHeaderButtonStyle}" Padding="8,3" />
                            </StackPanel>
                            <TextBlock Text="Outputs" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Owner.SelectedMethodOutputs}"
                                  SelectedItem="{Binding Owner.SelectedMethodOutput}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" RowHeight="28"
                                  Background="#FF353535" RowBackground="#FF414141"
                                  AlternatingRowBackground="#FF3B3B3B" GridLinesVisibility="All" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="0.9*" />
                                <DataGridTextColumn Header="Method variable" Binding="{Binding VariableName}" IsReadOnly="True" Width="1.2*" />
                                <DataGridComboBoxColumn Header="Type" ItemsSource="{StaticResource InputVariableDataTypes}"
                                                        SelectedItemBinding="{Binding ValueType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.85*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
