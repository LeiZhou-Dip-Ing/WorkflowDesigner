<Window x:Class="WorkflowCore.WpfDemo.Views.SharpScriptLibraryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Script Libraries"
        Width="1060" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" Foreground="#FF1E293B"
        Loaded="WindowOnLoaded">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="Foreground" Value="#FF1E293B" />
            <Setter Property="BorderBrush" Value="#FF606060" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="Foreground" Value="#FF1E293B" />
            <Setter Property="BorderBrush" Value="#FFD5DEE8" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="Foreground" Value="#FF1E293B" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="RowBackground" Value="#FFF8FAFC" />
            <Setter Property="AlternatingRowBackground" Value="#FF2D2D2D" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FF404040" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Import Managed DLL" Command="{Binding ImportManagedDllCommand}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Installed Libraries" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Libraries are installed by the Runtime; this Project stores only LibraryId and exact Version."
                           Foreground="#FF64748B" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Libraries}"
                      SelectedItem="{Binding SelectedLibrary}"
                      AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Project" Binding="{Binding IsInProject}" Width="64" />
                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="1.35*" />
                    <DataGridTextColumn Header="Library ID" Binding="{Binding LibraryId}" Width="1.25*" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" Width="115" />
                    <DataGridTextColumn Header="Local" Binding="{Binding LocalAvailability}" Width="100" />
                    <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeAvailability}" Width="100" />
                    <DataGridTextColumn Header="Framework" Binding="{Binding TargetFramework}" Width="100" />
                    <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="92" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,10,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Add to Project"
                            Command="{Binding AddToProjectCommand}"
                            CommandParameter="{Binding SelectedLibrary}" />
                    <Button Content="Remove from Project"
                            Command="{Binding RemoveFromProjectCommand}"
                            CommandParameter="{Binding SelectedLibrary}" />
                </StackPanel>
                <TextBlock Text="Select a Library to view details below."
                           Foreground="#FF64748B" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFF1F5F9" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Library details" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Namespaces" Foreground="#FF64748B" />
                            <TextBox Text="{Binding SelectedLibrary.Namespaces}" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="115" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Compile assemblies and hashes" Foreground="#FF64748B" />
                            <TextBox Text="{Binding SelectedLibrary.AssemblyDetails}" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="115" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FFF1F5F9" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Install exact NuGet Package" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PackageId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                 ToolTip="Package ID" />
                        <TextBox Grid.Column="1" Text="{Binding PackageVersion, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Exact version" />
                    </Grid>
                    <TextBox Grid.Row="2" Text="{Binding PackageSource, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Runtime-approved source" Margin="0,0,0,8" />
                    <Button Grid.Row="3" Content="Install" Command="{Binding InstallNuGetCommand}"
                            HorizontalAlignment="Right" MinWidth="100" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" MinWidth="90" Click="CloseOnClick" />
            <TextBlock Text="{Binding StatusText}" Foreground="#FF64748B" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
