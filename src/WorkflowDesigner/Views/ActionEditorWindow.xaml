<Window x:Class="WorkflowCore.WpfDemo.Views.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkflowCore.WpfDemo.Controls"
        Title="{Binding Title}"
        Width="1080"
        Height="700"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBrush}"
        Foreground="#FFF4F8FB"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12,9"
                Background="#FF252525"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding Description}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,10"
                Background="#FF333333"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Properties" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <controls:ActionPropertyPanel Grid.Row="1"
                                              ItemsSource="{Binding PropertiesView}"
                                              ActionContext="{Binding Context}"
                                              CreateValueCommand="{Binding CreateValueCommand}"
                                              ClearValueCommand="{Binding ClearValueCommand}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="90" IsCancel="True" Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
