<UserControl x:Class="WorkflowCore.WpfDemo.Views.SqlScriptEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:WorkflowCore.WpfDemo.Controls"
             Background="{DynamicResource AppPageBrush}"
             Foreground="{DynamicResource AppTextBrush}">
    <UserControl.Resources>
        <Style x:Key="SqlToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="SqlToolbarIcon" TargetType="Path">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="SqlToolbarSeparator" TargetType="Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="47" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="5" />
            <RowDefinition Height="125" MinHeight="85" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{Binding SaveCommand}" ToolTip="Save SQL script">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SqlToolbarIcon}" Data="M2,2 H13 L16,5 V16 H2 Z M5,2 V7 H12 V2 M5,16 V10 H13 V16" />
                            <TextBlock Text="Save" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource SqlToolbarSeparator}" />
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{x:Static ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=SqlEditor}" ToolTip="Undo">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M7,4 L3,8 L7,12 M3,8 H10 C14,8 16,10 16,14" /><TextBlock Text="Undo" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{x:Static ApplicationCommands.Redo}" CommandTarget="{Binding ElementName=SqlEditor}" ToolTip="Redo">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M11,4 L15,8 L11,12 M15,8 H8 C4,8 2,10 2,14" /><TextBlock Text="Redo" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Separator Style="{StaticResource SqlToolbarSeparator}" />
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{x:Static ApplicationCommands.Copy}" CommandTarget="{Binding ElementName=SqlEditor}" ToolTip="Copy selection">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M6,4 H16 V15 H6 Z M4,7 H2 V18 H13 V16" /><TextBlock Text="Copy" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{x:Static ApplicationCommands.Paste}" CommandTarget="{Binding ElementName=SqlEditor}" ToolTip="Paste into editor">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M5,4 H15 V17 H5 Z M8,2 H12 V5 H8 Z M7,10 H13 M7,13 H12" /><TextBlock Text="Paste" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Separator Style="{StaticResource SqlToolbarSeparator}" />
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{Binding ExportCommand}" ToolTip="Export SQL script document">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M9,3 H16 V10 M16,3 L8,11 M13,15 H3 V5 H8" /><TextBlock Text="Export" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Separator Style="{StaticResource SqlToolbarSeparator}" />
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{Binding ValidateCommand}" ToolTip="Check SQL syntax using the Runtime database">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M3,9 L7,13 L15,4 M3,3 H11 M3,16 H15" /><TextBlock Text="Validate" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{Binding ExecuteCommand}" ToolTip="Execute SQL against the Runtime database">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M5,3 L15,9 L5,15 Z" /><TextBlock Text="Execute" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{Binding ClearOutputCommand}" ToolTip="Clear output">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M3,5 H15 M6,5 V3 H12 V5 M5,6 L6,16 H12 L13,6 M8,8 V14 M10,8 V14" /><TextBlock Text="Clear output" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Separator Style="{StaticResource SqlToolbarSeparator}" />
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{Binding DeployCommand}" ToolTip="Deploy saved SQL script to the active Project">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M5,14 H3 C1,14 1,12 1,11 C1,9 2,8 4,8 C4,5 6,3 9,3 C12,3 14,5 14,7 C16,7 17,9 17,11 C17,13 16,14 14,14 H12 M9,15 V7 M6,10 L9,7 L12,10" /><TextBlock Text="Deploy" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SqlToolbarButton}" Command="{Binding CompareCommand}" ToolTip="Compare with deployed SQL script">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SqlToolbarIcon}" Data="M3,6 H14 M11,3 L14,6 L11,9 M15,12 H4 M7,9 L4,12 L7,15" /><TextBlock Text="Compare" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Margin="6,6,6,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <avalonEdit:TextEditor x:Name="SqlEditor" FontFamily="Cascadia Code,Consolas" FontSize="13.5"
                                   ShowLineNumbers="True" SyntaxHighlighting="TSQL" WordWrap="False"
                                   Background="{DynamicResource AppPanelBrush}" Foreground="{DynamicResource AppTextBrush}"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   controls:AvalonEditTextBinding.BoundText="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Border>
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource AppBorderBrush}" />

        <Border Grid.Row="3" Margin="6,0,6,6" Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="8,5">
                    <TextBlock Text="{Binding OutputMessage}" Foreground="{DynamicResource AppTextBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ResultRows}" AutoGenerateColumns="True"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          BorderThickness="0" GridLinesVisibility="Horizontal" />
            </Grid>
        </Border>
        <Border Grid.RowSpan="4" Panel.ZIndex="10" Background="#99000000"
                Visibility="{Binding IsParameterEntryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="530" MaxHeight="420" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Assign SQL parameters" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Cancel" Command="{Binding CancelParametersCommand}" MinWidth="85" Margin="0,0,8,0" />
                        <Button Content="Execute" Command="{Binding ConfirmParametersCommand}" MinWidth="85" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ParameterInputs}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MinHeight="100" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Parameter value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
