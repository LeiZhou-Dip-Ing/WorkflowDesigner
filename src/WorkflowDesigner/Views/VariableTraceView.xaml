<UserControl x:Class="WorkflowCore.WpfDemo.Views.VariableTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppPanelBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WorkflowEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TraceCellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{DynamicResource AppPanelBrush}" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="AutoScrollCheckBox" Content="Auto scroll" IsChecked="True"
                          VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Clear" Margin="4,4,0,4" Padding="12,2" MinWidth="58"
                        Click="ClearOnClick" />
            </StackPanel>
        </Grid>
        <DataGrid x:Name="TraceGrid" Grid.Row="1" ItemsSource="{Binding TraceEntries}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource AppCardBrush}" BorderThickness="0"
                  RowHeight="28" ColumnHeaderHeight="30"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"
                                    ElementStyle="{StaticResource TraceCellTextStyle}" />
                <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="65"
                                    ElementStyle="{StaticResource TraceCellTextStyle}" />
                <DataGridTemplateColumn Header="Action" Width="130" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Width="20" Height="20" Margin="0,0,6,0"
                                                Content="{Binding ActionTemplate}"
                                                ContentTemplate="{StaticResource ActionIconTemplate}" />
                                <TextBlock Text="{Binding ActionName}"
                                           Style="{StaticResource TraceCellTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Variable" Binding="{Binding Name}" Width="1.2*" MinWidth="120"
                                    ElementStyle="{StaticResource TraceCellTextStyle}" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" MinWidth="160"
                                    ElementStyle="{StaticResource TraceCellTextStyle}" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="85"
                                    ElementStyle="{StaticResource TraceCellTextStyle}" />
                <DataGridTextColumn Header="Change" Binding="{Binding Status}" Width="90"
                                    ElementStyle="{StaticResource TraceCellTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
