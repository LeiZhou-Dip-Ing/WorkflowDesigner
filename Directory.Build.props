<Project>
  <PropertyGroup>
    <WorkflowVersion>2.0.0-alpha.5</WorkflowVersion>
    <!-- Keep MSBuild intermediates in one repository-level folder so deep sample/test paths do not hit Windows MAX_PATH. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <!-- Once intermediates move, the SDK no longer excludes each project's legacy obj/bin folders automatically. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)**\obj\**;$(MSBuildThisFileDirectory)**\bin\**;$(MSBuildThisFileDirectory).obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The generated WPF temporary file names already contain the full project name. Use short buckets for the longest projects. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WorkflowRuntime.OpenCvSamplePlugin'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).obj\ocva\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WorkflowRuntime.TestScriptLibraryPlugin'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).obj\tslp\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
